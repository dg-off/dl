      "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_01.mp3",
      "text": "Marlowe wanted me to tell you that the offer still stands.",
      "duration": 4.524
    },
    {
      "order": 2,
      "character": "Dynamo",
      "audioFile": "dynamo_match_start_dynamo_haze_convo01_02",
      "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo01_02.mp3",
      "text": "For a moment I thought you said Marla and I got terribly confused.",
      "duration": 3.78
    },
    {
      "order": 3,
      "character": "Haze",
      "audioFile": "haze_match_start_dynamo_haze_convo01_03",
      "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_03.mp3",
      "text": "It's a good offer.",
      "duration": 2.103
    },
    {
      "order": 4,
      "character": "Dynamo",
      "audioFile": "dynamo_match_start_dynamo_haze_convo01_04",
      "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo01_04.mp3",
      "text": "I'm quite happy in the private sector.",
      "duration": 2.073
    },
    {
      "order": 5,
      "character": "Haze",
      "audioFile": "haze_match_start_dynamo_haze_convo01_05",
      "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_05.mp3",
