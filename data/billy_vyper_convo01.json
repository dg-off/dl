{
  "id": "billy_vyper_convo01",
  "lines": [
    {
      "order": 1,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_01",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_01.mp3",
      "text": "Don't think I've seen you since you got pinched.",
      "duration": 2.108
    },
    {
      "order": 2,
      "character": "Vyper",
      "audioFile": "viper_match_start_punkgoat_viper_convo01_02",
      "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_02.mp3",
      "text": "That's cause you never bothered to visit.  If I didn't know better I'd think you stop caring.",
      "duration": 5.322
    },
    {
      "order": 3,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_03",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_03.mp3",
      "text": "I just assumed you busted out.",
      "duration": 1.737
    },
    {
      "order": 4,
      "character": "Vyper",
      "audioFile": "viper_match_start_punkgoat_viper_convo01_04",
      "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_04.mp3",
      "text": "You're looking good.  New jacket?",
      "duration": 2.616
    },
    {
      "order": 5,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_05",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_05.mp3",
      "text": "You like it?",
      "duration": 0.715
    },
    {
      "order": 6,
      "character": "Vyper",
      "audioFile": "viper_match_start_punkgoat_viper_convo01_06",
      "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_06.mp3",
      "text": "I'll like it even better on the ground of a dark alley",
      "duration": 2.455
    },
    {
      "order": 7,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_07",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_07.mp3",
      "text": "Oh I know where we're going after the ritual.",
      "duration": 2.436
    },
    {
      "order": 8,
      "character": "Vyper",
      "audioFile": "viper_match_start_punkgoat_viper_convo01_08",
      "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_08.mp3",
      "text": "You mind if I call you Lash?",
      "duration": 1.71
    },
    {
      "order": 9,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_09",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_09.mp3",
      "text": "I don't give a shit.",
      "duration": 1.201
    }
  ]
}