      "audioFile": "wraith_match_start_kelvin_wraith_convo01_02",
      "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo01_02.mp3",
      "text": "I'm not cynical.",
      "duration": 1.226
    },
    {
      "order": 3,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_kelvin_wraith_convo01_03",
      "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo01_03.mp3",
      "text": "I've seen the contempt you have for your fellow man.",
