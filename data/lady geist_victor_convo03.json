{
  "id": "lady geist_victor_convo03",
  "lines": [
    {
      "order": 1,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_frank_ghost_convo03_01",
      "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_01.mp3",
      "text": "My son's a doctor, you should speak to him.",
      "duration": 3.154
    },
    {
      "order": 2,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_ghost_convo03_02",
      "audioUrl": "audio/frank_match_start_frank_ghost_convo03_02.mp3",
      "text": "What?",
      "duration": 1.064
    },
    {
      "order": 3,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_frank_ghost_convo03_03",
      "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_03.mp3",
      "text": "Your condition is only going to worsten without someone to maintain you, and Johann is one of the best in New York.  I'll introduce you when this ritual business is concluded.",
      "duration": 9.066
    },
    {
      "order": 4,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_ghost_convo03_04",
      "audioUrl": "audio/frank_match_start_frank_ghost_convo03_04.mp3",
      "text": "Why are you being nice to me\u2026",
      "duration": 1.659
    },
    {
      "order": 5,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_frank_ghost_convo03_05",
      "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_05.mp3",
      "text": "I don't know, but speak of it to no one I have a reputation to uphold.",
      "duration": 5.558
    }
  ]
}