      "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_01.mp3",
      "text": "What do I call you.",
      "duration": 1.767
    },
    {
      "order": 2,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_ghost_convo01_02",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo01_02.mp3",
      "text": "Not like you actually give a shit, but my name's Billy.",
      "duration": 2.732
    },
    {
      "order": 3,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_punkgoat_ghost_convo01_03",
      "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_03.mp3",
      "text": "No self respecting man actually wants to be called Billy.",
      "duration": 3.839
    },
    {
      "order": 4,
      "character": "Billy",
      "audioFile": "punkgoat_match_start_punkgoat_ghost_convo01_04",
      "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo01_04.mp3",
      "text": "Oh so now you know me.",
      "duration": 1.68
    },
    {
      "order": 5,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_punkgoat_ghost_convo01_05",
      "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_05.mp3",
      "text": "Believe me William, I wish I didn't",
      "duration": 3.114
    }
  ]
