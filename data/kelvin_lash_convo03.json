    {
      "order": 3,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_lash_kelvin_convo03_03",
      "audioUrl": "audio/kelvin_match_start_lash_kelvin_convo03_03.mp3",
      "text": "I'm not making an argument, I'm asking you to be nicer.",
