{
  "id": "calico_viper_convo01",
  "lines": [
    {
      "order": 1,
      "character": "Viper",
      "audioFile": "viper_match_start_viper_nano_convo01_01",
      "audioUrl": "audio/viper_match_start_viper_nano_convo01_01.mp3",
      "text": "It's nice to finally get to work with someone like me.",
      "duration": 3.171
    },
    {
      "order": 2,
      "character": "Calico",
      "audioFile": "nano_match_start_viper_nano_convo01_02",
      "audioUrl": "audio/nano_match_start_viper_nano_convo01_02.mp3",
      "text": "I'm nothing like you.",
      "duration": 1.376
    },
    {
      "order": 3,
      "character": "Viper",
      "audioFile": "viper_match_start_viper_nano_convo01_03",
      "audioUrl": "audio/viper_match_start_viper_nano_convo01_03.mp3",
      "text": "Come on, we're a couple of tough broads that kill people for money.",
      "duration": 3.942
    },
    {
      "order": 4,
      "character": "Calico",
      "audioFile": "nano_match_start_viper_nano_convo01_04",
      "audioUrl": "audio/nano_match_start_viper_nano_convo01_04.mp3",
      "text": "I kill people for money.  You kill people for a pack of cigarettes and a hot meal, we're not the same.",
      "duration": 4.867
    },
    {
      "order": 5,
      "character": "Viper",
      "audioFile": "viper_match_start_viper_nano_convo01_05",
      "audioUrl": "audio/viper_match_start_viper_nano_convo01_05.mp3",
      "text": "Sounding a little classist there C.",
      "duration": 3.572
    },
    {
      "order": 6,
      "character": "Calico",
      "audioFile": "nano_match_start_viper_nano_convo01_06",
      "audioUrl": "audio/nano_match_start_viper_nano_convo01_06.mp3",
      "text": "No I'm sounding a lot classist because I'm nothing like you.",
      "duration": 4.213
    }
  ]
}