{
  "id": "haze_victor_convo01",
  "lines": [
    {
      "order": 1,
      "character": "Haze",
      "audioFile": "haze_match_start_frank_haze_convo01_01",
      "audioUrl": "audio/haze_match_start_frank_haze_convo01_01.mp3",
      "text": "Can I ask you a personal question.",
      "duration": 2.865
    },
    {
      "order": 2,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_haze_convo01_02",
      "audioUrl": "audio/frank_match_start_frank_haze_convo01_02.mp3",
      "text": "Sure.",
      "duration": 1.102
    },
    {
      "order": 3,
      "character": "Haze",
      "audioFile": "haze_match_start_frank_haze_convo01_03",
      "audioUrl": "audio/haze_match_start_frank_haze_convo01_03.mp3",
      "text": "Do you dream?",
      "duration": 1.859
    },
    {
      "order": 4,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_haze_convo01_04",
      "audioUrl": "audio/frank_match_start_frank_haze_convo01_04.mp3",
      "text": "Dream with a capitol D? or just in general.",
      "duration": 2.875
    },
    {
      "order": 5,
      "character": "Haze",
      "audioFile": "haze_match_start_frank_haze_convo01_05",
      "audioUrl": "audio/haze_match_start_frank_haze_convo01_05.mp3",
      "text": "Like when you sleep.",
      "duration": 2.174
    },
    {
      "order": 6,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_haze_convo01_06",
      "audioUrl": "audio/frank_match_start_frank_haze_convo01_06.mp3",
      "text": "I do",
      "duration": 0.792
    },
    {
      "order": 7,
      "character": "Haze",
      "audioFile": "haze_match_start_frank_haze_convo01_07",
      "audioUrl": "audio/haze_match_start_frank_haze_convo01_07.mp3",
      "text": "Are they yours?  Or do you think they belong to parts of you.",
      "duration": 4.155
    },
    {
      "order": 8,
      "character": "Victor",
      "audioFile": "frank_match_start_frank_haze_convo01_08",
      "audioUrl": "audio/frank_match_start_frank_haze_convo01_08.mp3",
      "text": "I think they're mine.",
      "duration": 1.078
    },
    {
      "order": 9,
      "character": "Haze",
      "audioFile": "haze_match_start_frank_haze_convo01_09",
      "audioUrl": "audio/haze_match_start_frank_haze_convo01_09.mp3",
      "text": "Interesting.",
      "duration": 2.033
    }
  ]
}