      "audioFile": "viper_match_start_viper_kelvin_convo01_01",
      "audioUrl": "audio/viper_match_start_viper_kelvin_convo01_01.mp3",
      "text": "Hey, you're that judgy corpse, right?",
      "duration": 2.87
    },
    {
      "order": 2,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_viper_kelvin_convo01_02",
      "audioUrl": "audio/kelvin_match_start_viper_kelvin_convo01_02.mp3",
      "text": "I don't think I'm particularly judgemental",
      "duration": 2.532
    },
    {
      "order": 3,
      "character": "Viper",
      "audioFile": "viper_match_start_viper_kelvin_convo01_03",
      "audioUrl": "audio/viper_match_start_viper_kelvin_convo01_03.mp3",
      "text": "Whatcha think about me?",
      "duration": 1.141
    },
    {
      "order": 4,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_viper_kelvin_convo01_04",
      "audioUrl": "audio/kelvin_match_start_viper_kelvin_convo01_04.mp3",
      "text": "That you've spent more time inside prison than outside of it, so perhaps crime is not what you're best suited for.",
      "duration": 7.057
    },
    {
      "order": 5,
      "character": "Viper",
      "audioFile": "viper_match_start_viper_kelvin_convo01_05",
      "audioUrl": "audio/viper_match_start_viper_kelvin_convo01_05.mp3",
      "text": "Sounds pretty judgey",
      "duration": 1.635
    },
    {
      "order": 6,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_viper_kelvin_convo01_06",
      "audioUrl": "audio/kelvin_match_start_viper_kelvin_convo01_06.mp3",
      "text": "I suppose it does",
      "duration": 3.119
    }
  ]
