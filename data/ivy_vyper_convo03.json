    {
      "order": 3,
      "character": "Vyper",
      "audioFile": "viper_match_start_viper_tengu_convo03_03",
      "audioUrl": "audio/viper_match_start_viper_tengu_convo03_03.mp3",
      "text": "Oh no, they stabbed me, but you a can't keep a broad like me down.",
      "duration": 4.595
    },
    {
      "order": 4,
      "character": "Ivy",
      "audioFile": "tengu_match_start_viper_tengu_convo03_04",
      "audioUrl": "audio/tengu_match_start_viper_tengu_convo03_04.mp3",
      "text": "What do you want",
      "duration": 1.096
    },
    {
      "order": 5,
      "character": "Vyper",
      "audioFile": "viper_match_start_viper_tengu_convo03_05",
      "audioUrl": "audio/viper_match_start_viper_tengu_convo03_05.mp3",
      "text": "I just wanted to know how you feel about your sister working for Wraith.",
      "duration": 3.129
    },
    {
      "order": 6,
      "character": "Ivy",
      "audioFile": "tengu_match_start_viper_tengu_convo03_06",
      "audioUrl": "audio/tengu_match_start_viper_tengu_convo03_06.mp3",
      "text": "What are you talking about.",
      "duration": 1.338
    },
    {
      "order": 7,
      "character": "Vyper",
      "audioFile": "viper_match_start_viper_tengu_convo03_07",
      "audioUrl": "audio/viper_match_start_viper_tengu_convo03_07.mp3",
      "text": "Oh my god, you didn't know this is hilarious.",
      "duration": 4.225
    },
    {
      "order": 8,
      "character": "Ivy",
      "audioFile": "tengu_match_start_viper_tengu_convo03_08",
      "audioUrl": "audio/tengu_match_start_viper_tengu_convo03_08.mp3",
      "text": "What are you talking about, Viper",
      "duration": 2.267
