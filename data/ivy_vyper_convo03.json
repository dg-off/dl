    {
      "order": 9,
      "character": "Vyper",
      "audioFile": "viper_match_start_viper_tengu_convo03_09",
      "audioUrl": "audio/viper_match_start_viper_tengu_convo03_09.mp3",
      "text": "Sorry I love hearing about family drama,  but I'm not inserting myself in it unless a will's invovled.  Let's uh, let's go shoot some people.",
