      "duration": 3.122
    },
    {
      "order": 5,
      "character": "Dynamo",
      "audioFile": "dynamo_match_start_dynamo_haze_convo02_05",
      "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo02_05.mp3",
      "text": "That's a rather unsettling idea.",
