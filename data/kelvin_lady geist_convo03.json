{
  "id": "kelvin_lady geist_convo03",
  "lines": [
    {
      "order": 1,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_kelvin_convo03_01",
      "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_01.mp3",
      "text": "Whatever happened to your friend that caused a scene at your fundraiser?  His name was Edward, Edgar, something like that",
      "duration": 6.995
    },
    {
      "order": 2,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_ghost_kelvin_convo03_02",
      "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_02.mp3",
      "text": "Ettrick.",
      "duration": 1.049
    },
    {
      "order": 3,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_kelvin_convo03_03",
      "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_03.mp3",
      "text": "Yes.  Ettrick.",
      "duration": 1.656
    },
    {
      "order": 4,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_ghost_kelvin_convo03_04",
      "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_04.mp3",
      "text": "I don't know.  I tried to find him when I returned to New York but it's like he's vanished.",
      "duration": 6.211
    },
    {
      "order": 5,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_kelvin_convo03_05",
      "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_05.mp3",
      "text": "Well he was rather rude so I say good riddence",
      "duration": 3.566
    },
    {
      "order": 6,
      "character": "Kelvin",
      "audioFile": "kelvin_match_start_ghost_kelvin_convo03_06",
      "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_06.mp3",
      "text": "I wish I could share that sentiment",
      "duration": 2.639
    }
  ]
}