      "audioFile": "synth_match_start_dynamo_synth_convo03_02",
      "audioUrl": "audio/synth_match_start_dynamo_synth_convo03_02.mp3",
      "text": "Why's that.",
      "duration": 1.517
    },
    {
      "order": 3,
