{
  "id": "dynamo_seven_convo02",
  "lines": [
    {
      "order": 1,
      "character": "Seven",
      "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo02_01",
      "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo02_01.mp3",
      "text": "I'm a fan of your work Professor.",
      "duration": 2.537
    },
    {
      "order": 2,
      "character": "Dynamo",
      "audioFile": "dynamo_match_start_dynamo_gigawatt_convo02_02",
      "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo02_02.mp3",
      "text": "I am flattered and horrified in equal measure",
      "duration": 3.454
    },
    {
      "order": 3,
      "character": "Seven",
      "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo02_03",
      "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo02_03.mp3",
      "text": "Your research into the Astral Gates paved the way for my own.  In my rare moments of doubt, sometimes I even wonder if I would have became the man I am were it not for you.",
      "duration": 11.73
    },
    {
      "order": 4,
      "character": "Dynamo",
      "audioFile": "dynamo_match_start_dynamo_gigawatt_convo02_04",
      "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo02_04.mp3",
      "text": "and now I'm just horrifeid.",
      "duration": 1.623
    }
  ]
}