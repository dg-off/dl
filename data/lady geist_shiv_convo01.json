{
  "id": "lady geist_shiv_convo01",
  "lines": [
    {
      "order": 1,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_shiv_convo01_01",
      "audioUrl": "audio/ghost_match_start_ghost_shiv_convo01_01.mp3",
      "text": "After the ritual would you like to have a drink?",
      "duration": 2.569
    },
    {
      "order": 2,
      "character": "Shiv",
      "audioFile": "shiv_match_start_ghost_shiv_convo01_02",
      "audioUrl": "audio/shiv_match_start_ghost_shiv_convo01_02.mp3",
      "text": "I don't know, word on the street is that you're a dangerous woman to know.",
      "duration": 4.573
    },
    {
      "order": 3,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_shiv_convo01_03",
      "audioUrl": "audio/ghost_match_start_ghost_shiv_convo01_03.mp3",
      "text": "I'm a dangerous woman whether you know me or not.",
      "duration": 3.011
    },
    {
      "order": 4,
      "character": "Shiv",
      "audioFile": "shiv_match_start_ghost_shiv_convo01_04",
      "audioUrl": "audio/shiv_match_start_ghost_shiv_convo01_04.mp3",
      "text": "What bar?",
      "duration": 1.09
    },
    {
      "order": 5,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_shiv_convo01_05",
      "audioUrl": "audio/ghost_match_start_ghost_shiv_convo01_05.mp3",
      "text": "Jezebel's, assuming the barman's not dead.",
      "duration": 2.962
    },
    {
      "order": 6,
      "character": "Shiv",
      "audioFile": "shiv_match_start_ghost_shiv_convo01_06",
      "audioUrl": "audio/shiv_match_start_ghost_shiv_convo01_06.mp3",
      "text": "It\u2019s a date.",
      "duration": 1.183
    },
    {
      "order": 7,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_ghost_shiv_convo01_07",
      "audioUrl": "audio/ghost_match_start_ghost_shiv_convo01_07.mp3",
      "text": "Let's not get ahead of ourselves.",
      "duration": 2.327
    }
  ]
