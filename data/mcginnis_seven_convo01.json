      "audioFile": "forge_match_start_gigawatt_forge_convo01_02",
      "audioUrl": "audio/forge_match_start_gigawatt_forge_convo01_02.mp3",
      "text": "Not wasted, I'm getting paid a forturne.",
      "duration": 2.577
    },
    {
