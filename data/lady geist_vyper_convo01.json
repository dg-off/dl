    {
      "order": 4,
      "character": "Lady geist",
      "audioFile": "ghost_match_start_viper_ghost_convo01_04",
      "audioUrl": "audio/ghost_match_start_viper_ghost_convo01_04.mp3",
      "text": "Is that supposed to be a threat?",
