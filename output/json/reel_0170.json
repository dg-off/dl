      ]
    },
    {
      "conversationId": "lady geist_wraith_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Wraith",
          "audioFile": "wraith_match_start_ghost_wraith_convo01_01",
          "audioUrl": "audio/wraith_match_start_ghost_wraith_convo01_01.mp3",
          "text": "You know what the difference between us is?",
          "duration": 2.386
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_wraith_convo01_02",
          "audioUrl": "audio/ghost_match_start_ghost_wraith_convo01_02.mp3",
          "text": "You reek of new money?",
          "duration": 1.847
        },
        {
          "order": 3,
          "character": "Wraith",
          "audioFile": "wraith_match_start_ghost_wraith_convo01_03",
          "audioUrl": "audio/wraith_match_start_ghost_wraith_convo01_03.mp3",
          "text": "I worked for what I have, it wasn't handed to me.",
          "duration": 3.898
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_wraith_convo01_04",
          "audioUrl": "audio/ghost_match_start_ghost_wraith_convo01_04.mp3",
          "text": "Spoken with the conviction only true ignorance can bring.",
          "duration": 3.584
        }
      ]
    },
    {
      "conversationId": "lady geist_wraith_convo02",
      "lines": [
