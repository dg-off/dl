        },
        {
          "order": 6,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo03_06",
          "audioUrl": "audio/orion_match_start_frank_orion_convo03_06.mp3",
          "text": "That's a little reductive.",
          "duration": 1.378
        },
        {
          "order": 7,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo03_07",
          "audioUrl": "audio/frank_match_start_frank_orion_convo03_07.mp3",
          "text": "is it?",
          "duration": 0.687
        },
        {
          "order": 8,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo03_08",
          "audioUrl": "audio/orion_match_start_frank_orion_convo03_08.mp3",
          "text": "Yes.",
          "duration": 0.534
        }
      ]
    },
    {
      "conversationId": "ivy_victor_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_tengu_convo01_01",
          "audioUrl": "audio/frank_match_start_frank_tengu_convo01_01.mp3",
          "text": "So you were a gargoyle",
          "duration": 2.21
        },
        {
          "order": 2,
          "character": "Ivy",
          "audioFile": "tengu_match_start_frank_tengu_convo01_02",
          "audioUrl": "audio/tengu_match_start_frank_tengu_convo01_02.mp3",
          "text": "I mean, I am a gargoyle.",
          "duration": 1.909
        },
        {
          "order": 3,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_tengu_convo01_03",
          "audioUrl": "audio/frank_match_start_frank_tengu_convo01_03.mp3",
          "text": "Right, but like, you stone before you were alive",
          "duration": 4.776
        },
        {
          "order": 4,
          "character": "Ivy",
          "audioFile": "tengu_match_start_frank_tengu_convo01_04",
          "audioUrl": "audio/tengu_match_start_frank_tengu_convo01_04.mp3",
          "text": "Yeah.",
          "duration": 1.165
        },
        {
          "order": 5,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_tengu_convo01_05",
          "audioUrl": "audio/frank_match_start_frank_tengu_convo01_05.mp3",
          "text": "Do you know who made you?",
          "duration": 1.201
        },
        {
          "order": 6,
          "character": "Ivy",
          "audioFile": "tengu_match_start_frank_tengu_convo01_06",
          "audioUrl": "audio/tengu_match_start_frank_tengu_convo01_06.mp3",
          "text": "Who cares?  I was a hunk of rock.  My life started when I met the Arroyo's, anything before that doesn't really matter to me.",
          "duration": 8.278
        }
      ]
    },
    {
      "conversationId": "ivy_victor_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Ivy",
          "audioFile": "tengu_match_start_frank_tengu_convo02_01",
          "audioUrl": "audio/tengu_match_start_frank_tengu_convo02_01.mp3",
