        {
          "order": 2,
          "character": "Venator",
          "audioFile": "priest_match_start_priest_gigawatt_convo01_02",
          "audioUrl": "audio/priest_match_start_priest_gigawatt_convo01_02.mp3",
          "text": "The fact that there's not a stake throught your heart should be answer enough.",
          "duration": 3.767
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_priest_gigawatt_convo01_03",
          "audioUrl": "audio/gigawatt_match_start_priest_gigawatt_convo01_03.mp3",
          "text": "Orders it is.",
          "duration": 1.694
        },
        {
          "order": 4,
