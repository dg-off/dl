          "audioFile": "priest_match_start_priest_gigawatt_convo01_04",
          "audioUrl": "audio/priest_match_start_priest_gigawatt_convo01_04.mp3",
          "text": "Smart lad.",
          "duration": 1.299
        }
      ]
    },
    {
      "conversationId": "seven_venator_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Venator",
