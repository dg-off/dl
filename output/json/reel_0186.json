          "audioFile": "gigawatt_match_start_priest_gigawatt_convo01_01",
          "audioUrl": "audio/gigawatt_match_start_priest_gigawatt_convo01_01.mp3",
          "text": "Did your masters at The Vatican send you?  Or are you thinking for yourself for a change.",
          "duration": 6.014
