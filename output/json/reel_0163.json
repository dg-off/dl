{
  "conversations": [
    {
      "conversationId": "kelvin_lady geist_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo03_01",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_01.mp3",
          "text": "Whatever happened to your friend that caused a scene at your fundraiser?  His name was Edward, Edgar, something like that",
          "duration": 6.995
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo03_02",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_02.mp3",
          "text": "Ettrick.",
          "duration": 1.049
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo03_03",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_03.mp3",
          "text": "Yes.  Ettrick.",
          "duration": 1.656
        },
        {
          "order": 4,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo03_04",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_04.mp3",
          "text": "I don't know.  I tried to find him when I returned to New York but it's like he's vanished.",
          "duration": 6.211
        },
        {
          "order": 5,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo03_05",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo03_05.mp3",
          "text": "Well he was rather rude so I say good riddence",
          "duration": 3.566
        },
        {
          "order": 6,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo03_06",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo03_06.mp3",
          "text": "I wish I could share that sentiment",
          "duration": 2.639
        }
      ]
    },
    {
      "conversationId": "lady geist_mo&krill_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_krill_convo01_01",
          "audioUrl": "audio/ghost_match_start_ghost_krill_convo01_01.mp3",
          "text": "I can't believe I'm working with an oversized rat.",
          "duration": 3.21
        },
        {
          "order": 2,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo01_02",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo01_02.mp3",
          "text": "Mole.",
          "duration": 1.537
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_krill_convo01_03",
          "audioUrl": "audio/ghost_match_start_ghost_krill_convo01_03.mp3",
          "text": "Apologies for saying the wrong rodent.",
          "duration": 2.49
        },
        {
          "order": 4,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo01_04",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo01_04.mp3",
          "text": "Lady Geist, for now our purposes are aligned.  But if you wish for that pretty arm of yours to remain attached after the ritual, I suggest you be kinder to Maurice.",
          "duration": 11.39
        }
      ]
    },
    {
      "conversationId": "lady geist_mo&krill_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo02_01",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo02_01.mp3",
          "text": "That binding ward on your arm is very impressive.",
          "duration": 3.745
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_krill_convo02_02",
          "audioUrl": "audio/ghost_match_start_ghost_krill_convo02_02.mp3",
          "text": "Thank you.",
          "duration": 1.113
        },
        {
          "order": 3,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo02_03",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo02_03.mp3",
          "text": "Whoever made it was an artist at their craft.",
          "duration": 2.818
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_krill_convo02_04",
          "audioUrl": "audio/ghost_match_start_ghost_krill_convo02_04.mp3",
          "text": "Yes.  He really was.",
          "duration": 2.337
        }
      ]
    }
  ]
}