          "duration": 2.329
        },
        {
          "order": 3,
          "character": "Lash",
          "audioFile": "lash_match_start_haze_lash_convo02_03",
          "audioUrl": "audio/lash_match_start_haze_lash_convo02_03.mp3",
          "text": "I can see it now.  An impossibly handsome leading man.  An emotionally unavailable killing machine.  A little action.  A lot of sexual tension\u2026",
          "duration": 11.283
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_lash_convo02_04",
          "audioUrl": "audio/haze_match_start_haze_lash_convo02_04.mp3",
          "text": "Does he die at the end?",
          "duration": 2.339
        },
        {
          "order": 5,
          "character": "Lash",
          "audioFile": "lash_match_start_haze_lash_convo02_05",
          "audioUrl": "audio/lash_match_start_haze_lash_convo02_05.mp3",
          "text": "Yeah, you get it.",
          "duration": 2.688
        }
      ]
    },
    {
      "conversationId": "haze_lash_convo03",
      "lines": [
        {
          "order": 1,
