{
  "conversations": [
    {
      "conversationId": "dynamo_pocket_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Pocket",
          "audioFile": "synth_match_start_dynamo_synth_convo02_01",
          "audioUrl": "audio/synth_match_start_dynamo_synth_convo02_01.mp3",
          "text": "Are you still friends with my father?",
          "duration": 1.732
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_synth_convo02_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_synth_convo02_02.mp3",
          "text": "These days \"friends\" might be pushing it, but I'd say he has warm nostaliga for me",
          "duration": 7.502
        },
        {
          "order": 3,
          "character": "Pocket",
          "audioFile": "synth_match_start_dynamo_synth_convo02_03",
          "audioUrl": "audio/synth_match_start_dynamo_synth_convo02_03.mp3",
          "text": "He's not a good man.",
          "duration": 1.391
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_synth_convo02_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_synth_convo02_04.mp3",
          "text": "He's a complicated man.  There's a difference.",
          "duration": 2.639
        },
        {
          "order": 5,
          "character": "Pocket",
          "audioFile": "synth_match_start_dynamo_synth_convo02_05",
          "audioUrl": "audio/synth_match_start_dynamo_synth_convo02_05.mp3",
          "text": "Not to me.",
          "duration": 0.909
        }
      ]
    },
    {
      "conversationId": "dynamo_pocket_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_synth_convo03_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_synth_convo03_01.mp3",
          "text": "You should have told me you were alive, Arin.",
          "duration": 2.069
        },
        {
          "order": 2,
          "character": "Pocket",
          "audioFile": "synth_match_start_dynamo_synth_convo03_02",
          "audioUrl": "audio/synth_match_start_dynamo_synth_convo03_02.mp3",
          "text": "Why's that.",
          "duration": 1.517
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_synth_convo03_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_synth_convo03_03.mp3",
          "text": "I'm your godfather,  I would have helped you.",
          "duration": 1.962
        },
        {
          "order": 4,
          "character": "Pocket",
          "audioFile": "synth_match_start_dynamo_synth_convo03_04",
          "audioUrl": "audio/synth_match_start_dynamo_synth_convo03_04.mp3",
          "text": "I'm sorry, I just\u2026 I wasn't sure who I could trust.",
          "duration": 3.658
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_synth_convo03_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_synth_convo03_05.mp3",
          "text": "Well at least I'm here now.",
          "duration": 1.253
        }
      ]
    },
    {
      "conversationId": "dynamo_ivy_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo01_01",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo01_01.mp3",
          "text": "It's nice to meet you Professor, Sophia speaks very highly of you.",
          "duration": 4.047
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo01_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo01_02.mp3",
          "text": "That's kind of you to say.",
          "duration": 1.376
        },
        {
          "order": 3,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo01_03",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo01_03.mp3",
          "text": "It's just the truth.",
          "duration": 1.592
        }
      ]
    }
  ]
}