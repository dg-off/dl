{
  "conversations": [
    {
      "conversationId": "kelvin_wraith_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo01_01",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo01_01.mp3",
          "text": "We don't have time for cynicisim today Wratih.",
          "duration": 3.076
        },
        {
          "order": 2,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo01_02",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo01_02.mp3",
          "text": "I'm not cynical.",
          "duration": 1.226
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo01_03",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo01_03.mp3",
          "text": "I've seen the contempt you have for your fellow man.",
          "duration": 3.454
        },
        {
          "order": 4,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo01_04",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo01_04.mp3",
          "text": "You say contempt, I say managed expectations.",
          "duration": 3.53
        }
      ]
    },
    {
      "conversationId": "kelvin_wraith_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo02_01",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo02_01.mp3",
          "text": "What happened on your expedition?",
          "duration": 1.617
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo02_02",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo02_02.mp3",
          "text": "I wish I knew.",
          "duration": 1.597
        },
        {
          "order": 3,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo02_03",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo02_03.mp3",
          "text": "That why you're here?",
          "duration": 1.011
        },
        {
          "order": 4,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo02_04",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo02_04.mp3",
          "text": "Correct.  It's time I find answers.",
          "duration": 3.635
        }
      ]
    },
    {
      "conversationId": "kelvin_wraith_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo03_01",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo03_01.mp3",
          "text": "People say you're a noble man.",
          "duration": 1.573
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo03_02",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo03_02.mp3",
          "text": "That's very kind of them.",
          "duration": 1.821
        },
        {
          "order": 3,
          "character": "Wraith",
          "audioFile": "wraith_match_start_kelvin_wraith_convo03_03",
          "audioUrl": "audio/wraith_match_start_kelvin_wraith_convo03_03.mp3",
          "text": "Noble men tend to get other people killed.",
          "duration": 2.34
        },
        {
          "order": 4,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_wraith_convo03_04",
          "audioUrl": "audio/kelvin_match_start_kelvin_wraith_convo03_04.mp3",
          "text": "I will endevour to make  sure that's not the case.",
          "duration": 3.318
        }
      ]
    }
  ]
}