{
  "conversations": [
    {
      "conversationId": "graves_seven_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo01_01",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo01_01.mp3",
          "text": "Be careful child\u2026",
          "duration": 1.892
        },
        {
          "order": 2,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo01_02",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo01_02.mp3",
          "text": "What, or I'll end up like you?",
          "duration": 1.7
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo01_03",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo01_03.mp3",
          "text": "Please, stay on the path you're on and you won't live long enough to end up like me.",
          "duration": 5.93
        },
        {
          "order": 4,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo01_04",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo01_04.mp3",
          "text": "Don't pretend like you care if I live or die.",
          "duration": 2.294
        },
        {
          "order": 5,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo01_05",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo01_05.mp3",
          "text": "I'm not invested in your surivial, I just hate to see talent wasted.",
          "duration": 4.423
        }
      ]
    },
    {
      "conversationId": "graves_seven_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo02_01",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo02_01.mp3",
          "text": "Don't trust your mentor.",
          "duration": 1.788
        },
        {
          "order": 2,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo02_02",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo02_02.mp3",
          "text": "Why, cause she's a lich?",
          "duration": 1.444
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo02_03",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo02_03.mp3",
          "text": "No, because mentors only teach what they want you to learn.  They are craven and use the young to live glories they could not achieve on their own.",
          "duration": 10.412
        },
        {
          "order": 4,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo02_04",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo02_04.mp3",
          "text": "She's not like that.",
          "duration": 1.33
        },
        {
          "order": 5,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo02_05",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo02_05.mp3",
          "text": "Of couse not.  She sees potential in you that she's never seen in ages.  You're special.",
          "duration": 7.574
        },
        {
          "order": 6,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo02_06",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo02_06.mp3",
          "text": "You don't know what you're talking about.",
          "duration": 1.582
        },
        {
          "order": 7,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo02_07",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo02_07.mp3",
          "text": "You're right.  How silly of me.",
          "duration": 3.077
        }
      ]
    },
    {
      "conversationId": "graves_seven_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo03_01",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo03_01.mp3",
          "text": "I'm able to hold my own.",
          "duration": 1.688
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo03_02",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo03_02.mp3",
          "text": "I never said you couldn't.",
          "duration": 1.84
        },
        {
          "order": 3,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_gigawatt_convo03_03",
          "audioUrl": "audio/necro_match_start_necro_gigawatt_convo03_03.mp3",
          "text": "I know I'm young, but -",
          "duration": 1.457
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_necro_gigawatt_convo03_04",
          "audioUrl": "audio/gigawatt_match_start_necro_gigawatt_convo03_04.mp3",
          "text": "I don't care how old you are.  If you're compotent you'll survive, if you're not you'll die - either way you're not my concern.",
          "duration": 8.412
        }
      ]
    }
  ]
}