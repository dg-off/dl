          "order": 5,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_inferno_convo02_05",
          "audioUrl": "audio/necro_match_start_necro_inferno_convo02_05.mp3",
          "text": "That's not what my classmates say.",
