          "duration": 0.828
        },
        {
          "order": 3,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_inferno_convo02_03",
          "audioUrl": "audio/necro_match_start_necro_inferno_convo02_03.mp3",
          "text": "Yeah.  Supposedly you're with the mob.",
