        },
        {
          "order": 4,
          "character": "Infernus",
          "audioFile": "inferno_match_start_necro_inferno_convo01_04",
          "audioUrl": "audio/inferno_match_start_necro_inferno_convo01_04.mp3",
          "text": "She tried.  But ain't no amount of money worth risking Jezebel's getting shut down.",
          "duration": 5.008
        },
        {
          "order": 5,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_inferno_convo01_05",
          "audioUrl": "audio/necro_match_start_necro_inferno_convo01_05.mp3",
          "text": "God I would have loved to see her face.",
          "duration": 1.873
        },
        {
          "order": 6,
          "character": "Infernus",
          "audioFile": "inferno_match_start_necro_inferno_convo01_06",
          "audioUrl": "audio/inferno_match_start_necro_inferno_convo01_06.mp3",
          "text": "Not gonna lie, it was satisfying.",
          "duration": 2.687
        }
      ]
    },
    {
      "conversationId": "graves_infernus_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_inferno_convo02_01",
          "audioUrl": "audio/necro_match_start_necro_inferno_convo02_01.mp3",
