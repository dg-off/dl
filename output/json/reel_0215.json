        {
          "order": 6,
          "character": "Infernus",
          "audioFile": "inferno_match_start_necro_inferno_convo02_06",
          "audioUrl": "audio/inferno_match_start_necro_inferno_convo02_06.mp3",
          "text": "I don't know if I'd trust the Blackmore Academy rumor mill.",
