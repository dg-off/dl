        {
          "order": 3,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_inferno_convo01_03",
          "audioUrl": "audio/necro_match_start_necro_inferno_convo01_03.mp3",
          "text": "Surprised she didn\u2019t just bribe you.",
