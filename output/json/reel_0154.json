{
  "conversations": [
    {
      "conversationId": "lady geist_victor_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_frank_ghost_convo03_01",
          "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_01.mp3",
          "text": "My son's a doctor, you should speak to him.",
          "duration": 3.154
        },
        {
          "order": 2,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_ghost_convo03_02",
          "audioUrl": "audio/frank_match_start_frank_ghost_convo03_02.mp3",
          "text": "What?",
          "duration": 1.064
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_frank_ghost_convo03_03",
          "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_03.mp3",
          "text": "Your condition is only going to worsten without someone to maintain you, and Johann is one of the best in New York.  I'll introduce you when this ritual business is concluded.",
          "duration": 9.066
        },
        {
          "order": 4,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_ghost_convo03_04",
          "audioUrl": "audio/frank_match_start_frank_ghost_convo03_04.mp3",
          "text": "Why are you being nice to me\u2026",
          "duration": 1.659
        },
        {
          "order": 5,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_frank_ghost_convo03_05",
          "audioUrl": "audio/ghost_match_start_frank_ghost_convo03_05.mp3",
          "text": "I don't know, but speak of it to no one I have a reputation to uphold.",
          "duration": 5.558
        }
      ]
    },
    {
      "conversationId": "haze_victor_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo01_01",
          "audioUrl": "audio/haze_match_start_frank_haze_convo01_01.mp3",
          "text": "Can I ask you a personal question.",
          "duration": 2.865
        },
        {
          "order": 2,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo01_02",
          "audioUrl": "audio/frank_match_start_frank_haze_convo01_02.mp3",
          "text": "Sure.",
          "duration": 1.102
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo01_03",
          "audioUrl": "audio/haze_match_start_frank_haze_convo01_03.mp3",
          "text": "Do you dream?",
          "duration": 1.859
        },
        {
          "order": 4,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo01_04",
          "audioUrl": "audio/frank_match_start_frank_haze_convo01_04.mp3",
          "text": "Dream with a capitol D? or just in general.",
          "duration": 2.875
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo01_05",
          "audioUrl": "audio/haze_match_start_frank_haze_convo01_05.mp3",
          "text": "Like when you sleep.",
          "duration": 2.174
        },
        {
          "order": 6,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo01_06",
          "audioUrl": "audio/frank_match_start_frank_haze_convo01_06.mp3",
          "text": "I do",
          "duration": 0.792
        },
        {
          "order": 7,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo01_07",
          "audioUrl": "audio/haze_match_start_frank_haze_convo01_07.mp3",
          "text": "Are they yours?  Or do you think they belong to parts of you.",
          "duration": 4.155
        },
        {
          "order": 8,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo01_08",
          "audioUrl": "audio/frank_match_start_frank_haze_convo01_08.mp3",
          "text": "I think they're mine.",
          "duration": 1.078
        },
        {
          "order": 9,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo01_09",
          "audioUrl": "audio/haze_match_start_frank_haze_convo01_09.mp3",
          "text": "Interesting.",
          "duration": 2.033
        }
      ]
    },
    {
      "conversationId": "haze_victor_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo02_01",
          "audioUrl": "audio/haze_match_start_frank_haze_convo02_01.mp3",
          "text": "So you find out where you came from, what comes next.",
          "duration": 4.192
        },
        {
          "order": 2,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo02_02",
          "audioUrl": "audio/frank_match_start_frank_haze_convo02_02.mp3",
          "text": "Never really thought about it.",
          "duration": 1.666
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo02_03",
          "audioUrl": "audio/haze_match_start_frank_haze_convo02_03.mp3",
          "text": "You should.",
          "duration": 1.633
        },
        {
          "order": 4,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo02_04",
          "audioUrl": "audio/frank_match_start_frank_haze_convo02_04.mp3",
          "text": "Any suggestions?",
          "duration": 1.377
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_frank_haze_convo02_05",
          "audioUrl": "audio/haze_match_start_frank_haze_convo02_05.mp3",
          "text": "I'm biased, but I think you should consider the OSIC.",
          "duration": 4.519
        },
        {
          "order": 6,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_haze_convo02_06",
          "audioUrl": "audio/frank_match_start_frank_haze_convo02_06.mp3",
          "text": "I'll keep that in mind.",
          "duration": 1.314
        }
      ]
    }
  ]
}