{
  "conversations": [
    {
      "conversationId": "infernus_lady geist_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Infernus",
          "audioFile": "inferno_match_start_ghost_inferno_convo03_01",
          "audioUrl": "audio/inferno_match_start_ghost_inferno_convo03_01.mp3",
          "text": "What's Johann up to?",
          "duration": 1.154
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_inferno_convo03_02",
          "audioUrl": "audio/ghost_match_start_ghost_inferno_convo03_02.mp3",
          "text": "At this moment his two favorite hobbies are medicine and being sanctamonious.",
          "duration": 4.493
        },
        {
          "order": 3,
          "character": "Infernus",
          "audioFile": "inferno_match_start_ghost_inferno_convo03_03",
          "audioUrl": "audio/inferno_match_start_ghost_inferno_convo03_03.mp3",
          "text": "He's a good kid.",
          "duration": 1.113
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_inferno_convo03_04",
          "audioUrl": "audio/ghost_match_start_ghost_inferno_convo03_04.mp3",
          "text": "I'll keep him for now.",
          "duration": 1.66
        }
      ]
    },
    {
      "conversationId": "kelvin_lady geist_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo01_01",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo01_01.mp3",
          "text": "I never got to say thank you for your patronage Lady Geist.",
          "duration": 3.802
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo01_02",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo01_02.mp3",
          "text": "Sarcasm doesn't suit you Kelvin.",
          "duration": 2.664
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo01_03",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo01_03.mp3",
          "text": "I'm serious.  Obviously the expidition didn't go as planned, but we wouldn't have had the opportunity were it not for your funding.",
          "duration": 8.724
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo01_04",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo01_04.mp3",
          "text": "What happened.",
          "duration": 1.006
        },
        {
          "order": 5,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo01_05",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo01_05.mp3",
          "text": "I don't know, but I intend to find out.",
          "duration": 3.657
        }
      ]
    },
    {
      "conversationId": "kelvin_lady geist_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo02_01",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo02_01.mp3",
          "text": "You seem to be short on friends Lady Geist",
          "duration": 3.101
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo02_02",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo02_02.mp3",
          "text": "I don't need friends, that's what money's for.",
          "duration": 3.477
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_ghost_kelvin_convo02_03",
          "audioUrl": "audio/kelvin_match_start_ghost_kelvin_convo02_03.mp3",
          "text": "That way of thinking is a fast path to a lonely life\u2026 you'll realize that when you're older.",
          "duration": 5.881
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_kelvin_convo02_04",
          "audioUrl": "audio/ghost_match_start_ghost_kelvin_convo02_04.mp3",
          "text": "Kelvin.  Believe me when I tell you that you have no idea what you're talking about.",
          "duration": 5.194
        }
      ]
    }
  ]
}