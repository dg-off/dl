        },
        {
          "order": 3,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_forge_orion_convo01_03",
          "audioUrl": "audio/forge_match_start_forge_orion_convo01_03.mp3",
          "text": "Charm doesn't win fights.  You know what does? Guns.  Which you don't have.",
          "duration": 4.71
        },
        {
          "order": 4,
          "character": "Grey talon",
          "audioFile": "orion_match_start_forge_orion_convo01_04",
          "audioUrl": "audio/orion_match_start_forge_orion_convo01_04.mp3",
          "text": "I'll be fine.",
          "duration": 1.15
        }
      ]
    },
    {
      "conversationId": "grey talon_mcginnis_convo02",
      "lines": [
        {
