{
  "conversations": [
    {
      "conversationId": "dynamo_ivy_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo02_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo02_01.mp3",
          "text": "You're Sophia Arroyo's sister, right?",
          "duration": 1.974
        },
        {
          "order": 2,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo02_02",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo02_02.mp3",
          "text": "Yeah, everything ok?",
          "duration": 2.072
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo02_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo02_03.mp3",
          "text": "Ok-ish.  She's a great student, but lately she's been falling asleep in class.  She she says she's been pulling long shifts at her job and it's wearing her out.",
          "duration": 9.482
        },
        {
          "order": 4,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo02_04",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo02_04.mp3",
          "text": "I didn't even know Sophia had a job.",
          "duration": 2.573
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo02_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo02_05.mp3",
          "text": "Well, if you could talk to her I think it'd do a world of good",
          "duration": 2.742
        },
        {
          "order": 6,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo02_06",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo02_06.mp3",
          "text": "I will, thanks.",
          "duration": 1.494
        }
      ]
    },
    {
      "conversationId": "dynamo_ivy_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo03_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo03_01.mp3",
          "text": "So Ivy, how long have you been a vigilante.",
          "duration": 2.943
        },
        {
          "order": 2,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo03_02",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo03_02.mp3",
          "text": "Oh, my whole life.  It was a calling, but with Mendoza gone I think I'm ready to find a career.",
          "duration": 6.48
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_tengu_convo03_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_tengu_convo03_03.mp3",
          "text": "Well, if we survive and you need a reference, let me know.",
          "duration": 2.64
        },
        {
          "order": 4,
          "character": "Ivy",
          "audioFile": "tengu_match_start_dynamo_tengu_convo03_04",
          "audioUrl": "audio/tengu_match_start_dynamo_tengu_convo03_04.mp3",
          "text": "Thanks Professor.",
          "duration": 1.395
        }
      ]
    },
    {
      "conversationId": "dynamo_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_01.mp3",
          "text": "Well aren't you a facinating creature\u2026",
          "duration": 2.032
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_02",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_02.mp3",
          "text": "I think so.",
          "duration": 1.159
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_03.mp3",
          "text": "When the ritual is over I'd love to pick your brain.",
          "duration": 3.256
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_04",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_04.mp3",
          "text": "Please don't stab my face",
          "duration": 1.889
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_05.mp3",
          "text": "Oh!  It's an expression, it means to ask questions.",
          "duration": 3.459
        },
        {
          "order": 6,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_06",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_06.mp3",
          "text": "Oh, that sounds more fun.  OK!",
          "duration": 2.961
        }
      ]
    }
  ]
}