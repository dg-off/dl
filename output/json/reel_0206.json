{
  "conversations": [
    {
      "conversationId": "kelvin_vindicta_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo01_01",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo01_01.mp3",
          "text": "So you're a wight?",
          "duration": 1.3
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_hornet_convo01_02",
          "audioUrl": "audio/kelvin_match_start_kelvin_hornet_convo01_02.mp3",
          "text": "Some people say revenant, but I'm not sure if there's really a difference.",
          "duration": 4.708
        },
        {
          "order": 3,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo01_03",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo01_03.mp3",
          "text": "I understand.  I just stick with ghost for simplicities sake.",
          "duration": 3.971
        }
      ]
    },
    {
      "conversationId": "kelvin_vindicta_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo02_01",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo02_01.mp3",
          "text": "That ice dome of yours had best not block my line of sight.",
          "duration": 3.061
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_hornet_convo02_02",
          "audioUrl": "audio/kelvin_match_start_kelvin_hornet_convo02_02.mp3",
          "text": "Vindicta, my priority will always be saving life; not faciliting you ending it.",
          "duration": 6.189
        },
        {
          "order": 3,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo02_03",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo02_03.mp3",
          "text": "That's your problem Kelvin\u2026 I am saving life.",
          "duration": 3.447
        }
      ]
    },
    {
      "conversationId": "kelvin_vindicta_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo03_01",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo03_01.mp3",
          "text": "How are you adjusting?",
          "duration": 1.407
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_hornet_convo03_02",
          "audioUrl": "audio/kelvin_match_start_kelvin_hornet_convo03_02.mp3",
          "text": "It's strange returning after being gone for a year.",
          "duration": 3.229
        },
        {
          "order": 3,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo03_03",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo03_03.mp3",
          "text": "Try 200.",
          "duration": 1.499
        },
        {
          "order": 4,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_hornet_convo03_04",
          "audioUrl": "audio/kelvin_match_start_kelvin_hornet_convo03_04.mp3",
          "text": "Oh, by no means was I trying to draw comparisons\u2026 how long did it take you to make sense of the modern world.",
          "duration": 7.003
        },
        {
          "order": 5,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo03_05",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo03_05.mp3",
          "text": "A while.  People always ask me about adapting to technology, but really the language was the hardest. For a while I felt lost, but I was able to find my way and my purpose.",
          "duration": 12.785
        },
        {
          "order": 6,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_hornet_convo03_06",
          "audioUrl": "audio/kelvin_match_start_kelvin_hornet_convo03_06.mp3",
          "text": "A lust for murder isn't purpose Vindicta.",
          "duration": 3.179
        },
        {
          "order": 7,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_kelvin_hornet_convo03_07",
          "audioUrl": "audio/hornet_match_start_kelvin_hornet_convo03_07.mp3",
          "text": "That's not for you to say Kelvin.  You weren't there.",
          "duration": 3.655
        }
      ]
    }
  ]
}