          "order": 6,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_haze_kelvin_convo02_06",
          "audioUrl": "audio/kelvin_match_start_haze_kelvin_convo02_06.mp3",
          "text": "Thank you.",
          "duration": 1.012
        }
      ]
    },
    {
