        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_kelvin_convo01_02",
          "audioUrl": "audio/haze_match_start_haze_kelvin_convo01_02.mp3",
          "text": "More like horrifying.",
          "duration": 2.486
