        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_haze_kelvin_convo01_03",
          "audioUrl": "audio/kelvin_match_start_haze_kelvin_convo01_03.mp3",
          "text": "That many nightmares?",
          "duration": 1.806
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_kelvin_convo01_04",
          "audioUrl": "audio/haze_match_start_haze_kelvin_convo01_04.mp3",
          "text": "Nightmares are easy.  There's enough commonality in what people are afraid of\u2026 What's scary is what people dream for.",
          "duration": 8.764
        }
      ]
    },
    {
      "conversationId": "haze_kelvin_convo02",
      "lines": [
        {
