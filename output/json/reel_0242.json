      ]
    },
    {
      "conversationId": "billy_grey talon_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_orion_convo01_01",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_orion_convo01_01.mp3",
          "text": "They got a group of trained killers and we got a guy with a busted hip and one foot in the grave, this is fair.",
          "duration": 6.693
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_punkgoat_orion_convo01_02",
          "audioUrl": "audio/orion_match_start_punkgoat_orion_convo01_02.mp3",
          "text": "I'll be fine.",
          "duration": 1.4
        },
        {
          "order": 3,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_orion_convo01_03",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_orion_convo01_03.mp3",
          "text": "Basically this is 5 on 6, the patron must hate us.",
          "duration": 3.785
        },
        {
          "order": 4,
          "character": "Grey talon",
          "audioFile": "orion_match_start_punkgoat_orion_convo01_04",
          "audioUrl": "audio/orion_match_start_punkgoat_orion_convo01_04.mp3",
          "text": "The patron doesn't hate you.  I do.",
          "duration": 2.91
        }
      ]
    },
    {
      "conversationId": "billy_grey talon_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_orion_convo02_01",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_orion_convo02_01.mp3",
          "text": "I bet the Baxter society never killed any real monsters, it was all a bunch of smoke and mirrors for publicity.",
          "duration": 6.356
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_punkgoat_orion_convo02_02",
          "audioUrl": "audio/orion_match_start_punkgoat_orion_convo02_02.mp3",
          "text": "You don't know what you're talking about.",
          "duration": 1.689
        },
        {
          "order": 3,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_orion_convo02_03",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_orion_convo02_03.mp3",
          "text": "Big surprise, the mastermind of the whole charade tells me I'm wrong.",
          "duration": 4.091
        },
        {
          "order": 4,
          "character": "Grey talon",
          "audioFile": "orion_match_start_punkgoat_orion_convo02_04",
          "audioUrl": "audio/orion_match_start_punkgoat_orion_convo02_04.mp3",
          "text": "You being a moron has nothing to do with me starting the Baxter Society",
          "duration": 4.427
        }
      ]
    }
  ]
