{
  "conversations": [
    {
      "conversationId": "dynamo_lady geist_convo01_oathkeeper",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_ghost_oathkeeper_convo01_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_ghost_oathkeeper_convo01_01.mp3",
          "text": "Pleasure to see you again, Lady Geist.",
          "duration": 1.746
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_dynamo_ghost_oathkeeper_convo01_02",
          "audioUrl": "audio/ghost_match_start_dynamo_ghost_oathkeeper_convo01_02.mp3",
          "text": "Thank you for your help, Professor.",
          "duration": 2.243
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_ghost_oathkeeper_convo01_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_ghost_oathkeeper_convo01_03.mp3",
          "text": "Thank you for the funding. I trust that your Oath Keeper situation has been resolved.",
          "duration": 4.225
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_dynamo_ghost_oathkeeper_convo01_04",
          "audioUrl": "audio/ghost_match_start_dynamo_ghost_oathkeeper_convo01_04.mp3",
          "text": "I would say mitigated to my satisfaction.",
          "duration": 3.137
        }
      ]
    },
    {
      "conversationId": "dynamo_lady geist_convo02_oathkeeper",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_dynamo_ghost_oathkeeper_convo02_01",
          "audioUrl": "audio/ghost_match_start_dynamo_ghost_oathkeeper_convo02_01.mp3",
          "text": "You're a man of science, Professor. Do you think what they say about the patrons is true?",
          "duration": 4.906
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_ghost_oathkeeper_convo02_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_ghost_oathkeeper_convo02_02.mp3",
          "text": "Well, it's clear that the Patrons are beings of immense power. Whether or not they actually intend to fulfill their end of the bargain is less about science and more about their nature. On the plus side, we're about to find out.",
          "duration": 12.832
        }
      ]
    },
    {
      "conversationId": "dynamo_seven_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo01_01",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo01_01.mp3",
          "text": "I don't understand you, professor\u2026 you've been bestowed a great gift, and you're willing to throw it all away for nothing.",
          "duration": 7.746
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo01_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo01_02.mp3",
          "text": "Easy words to say when you've never loved someone.",
          "duration": 2.341
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo01_03",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo01_03.mp3",
          "text": "No.  Easy words to say when you have.",
          "duration": 3.317
        }
      ]
    }
  ]
}