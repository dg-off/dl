      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo02_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo02_01.mp3",
          "text": "So you're in the Sandman Division.",
          "duration": 1.858
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo02_02",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo02_02.mp3",
          "text": "Yes.",
          "duration": 1.316
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo02_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo02_03.mp3",
          "text": "Are there a lot of you?",
          "duration": 1.046
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo02_04",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo02_04.mp3",
          "text": "Enough that we call ourselves a divison.",
          "duration": 3.122
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo02_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo02_05.mp3",
          "text": "That's a rather unsettling idea.",
          "duration": 1.85
        },
        {
          "order": 6,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo02_06",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo02_06.mp3",
          "text": "We like it that way.",
          "duration": 2.022
        }
      ]
    },
    {
      "conversationId": "dynamo_haze_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo03_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo03_01.mp3",
          "text": "Once I open the blackhole I'm going to be pretty exposed.",
          "duration": 3.145
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo03_02",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo03_02.mp3",
          "text": "Don't worry professor, I'll do what I can to capitalize on the opportunity.",
          "duration": 5.811
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo03_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo03_03.mp3",
          "text": "I'm not worried about you capitalizing on the opportunity, I'm worried about dying in the process.",
          "duration": 4.754
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo03_04",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo03_04.mp3",
          "text": "Your surival may not be a top priority, but it is still a priority.",
          "duration": 5.52
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo03_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo03_05.mp3",
          "text": "Great\u2026",
          "duration": 0.927
        }
      ]
    },
    {
      "conversationId": "dynamo_vindicta_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_dynamo_hornet_convo01_01",
          "audioUrl": "audio/hornet_match_start_dynamo_hornet_convo01_01.mp3",
          "text": "Hold them in place Professor, and leave the rest to me.",
          "duration": 2.714
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_hornet_convo01_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_hornet_convo01_02.mp3",
          "text": "That sound's rather ominous and I'm ok not asking questions",
          "duration": 3.522
        }
      ]
    }
