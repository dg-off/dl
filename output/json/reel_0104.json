          "audioUrl": "audio/viper_match_start_viper_wraith_convo01_04.mp3",
          "text": "Cool, yeah I stabbed the hell outta her, not a fan.",
          "duration": 2.695
        }
      ]
    },
    {
      "conversationId": "viper_wraith_convo02",
      "lines": [
        {
          "order": 1,
