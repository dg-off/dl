          "order": 4,
          "character": "Wraith",
          "audioFile": "wraith_match_start_viper_wraith_convo02_04",
          "audioUrl": "audio/wraith_match_start_viper_wraith_convo02_04.mp3",
          "text": "It's not.  But tell you what; if we complete the ritual we'll call things square.",
          "duration": 4.241
