          "order": 5,
          "character": "Viper",
          "audioFile": "viper_match_start_viper_wraith_convo02_05",
          "audioUrl": "audio/viper_match_start_viper_wraith_convo02_05.mp3",
          "text": "I'll take it.",
          "duration": 1.073
        }
      ]
