          "order": 3,
          "character": "Viper",
          "audioFile": "viper_match_start_viper_wraith_convo02_03",
          "audioUrl": "audio/viper_match_start_viper_wraith_convo02_03.mp3",
          "text": "Why? Cause I tried to rob one of your poker rooms?  That's like ancient history.",
