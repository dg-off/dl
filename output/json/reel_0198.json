{
  "conversations": [
    {
      "conversationId": "graves_haze_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo01_01",
          "audioUrl": "audio/haze_match_start_necro_haze_convo01_01.mp3",
          "text": "I need you to speak with a Curator after the ritual",
          "duration": 3.88
        },
        {
          "order": 2,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo01_02",
          "audioUrl": "audio/necro_match_start_necro_haze_convo01_02.mp3",
          "text": "Why.",
          "duration": 0.657
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo01_03",
          "audioUrl": "audio/haze_match_start_necro_haze_convo01_03.mp3",
          "text": "Are you really asking me that?",
          "duration": 2.789
        },
        {
          "order": 4,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo01_04",
          "audioUrl": "audio/necro_match_start_necro_haze_convo01_04.mp3",
          "text": "Everythings fine.",
          "duration": 1.221
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo01_05",
          "audioUrl": "audio/haze_match_start_necro_haze_convo01_05.mp3",
          "text": "Then it shouldn't be a problem.",
          "duration": 2.41
        }
      ]
    },
    {
      "conversationId": "graves_haze_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo02_01",
          "audioUrl": "audio/haze_match_start_necro_haze_convo02_01.mp3",
          "text": "Have you started thinking about your future?",
          "duration": 3.15
        },
        {
          "order": 2,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo02_02",
          "audioUrl": "audio/necro_match_start_necro_haze_convo02_02.mp3",
          "text": "Right now I'm worried about living long enough to graduate.",
          "duration": 2.901
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo02_03",
          "audioUrl": "audio/haze_match_start_necro_haze_convo02_03.mp3",
          "text": "The OSIC could use someone like you.",
          "duration": 3.477
        },
        {
          "order": 4,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo02_04",
          "audioUrl": "audio/necro_match_start_necro_haze_convo02_04.mp3",
          "text": "Not interested in being a sandman.",
          "duration": 1.803
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo02_05",
          "audioUrl": "audio/haze_match_start_necro_haze_convo02_05.mp3",
          "text": "And I'm not interested in you being one.  But we have multiple divisions\u2026 and I think you might like being a Medium",
          "duration": 8.315
        },
        {
          "order": 6,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo02_06",
          "audioUrl": "audio/necro_match_start_necro_haze_convo02_06.mp3",
          "text": "That might not suck.",
          "duration": 3.272
        },
        {
          "order": 7,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo02_07",
          "audioUrl": "audio/haze_match_start_necro_haze_convo02_07.mp3",
          "text": "Think about it.  You can give me a call later",
          "duration": 3.615
        }
      ]
    },
    {
      "conversationId": "graves_haze_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_haze_convo03_01",
          "audioUrl": "audio/necro_match_start_necro_haze_convo03_01.mp3",
          "text": "Surprised you're not trying to take the hand.",
          "duration": 1.816
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_necro_haze_convo03_02",
          "audioUrl": "audio/haze_match_start_necro_haze_convo03_02.mp3",
          "text": "Curator's care about things, Sandmen care about people.  So until you become a threat to national security you're not my problem.",
          "duration": 9.356
        }
      ]
    }
  ]
}