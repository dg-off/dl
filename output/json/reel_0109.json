{
  "conversations": [
    {
      "conversationId": "holliday_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo01_01.mp3",
          "text": "I like your hat.",
          "duration": 1.734
        },
        {
          "order": 2,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo01_02",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo01_02.mp3",
          "text": "Thanks?",
          "duration": 1.341
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo01_03.mp3",
          "text": "Can I wear it?",
          "duration": 1.242
        },
        {
          "order": 4,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo01_04",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo01_04.mp3",
          "text": "Tell ya what, if we win, sure.",
          "duration": 2.818
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo01_05",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo01_05.mp3",
          "text": "yeaaaaaaa",
          "duration": 1.801
        }
      ]
    },
    {
      "conversationId": "holliday_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo02_01",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo02_01.mp3",
          "text": "So where are you from?",
          "duration": 1.439
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo02_02",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo02_02.mp3",
          "text": "The Deep.",
          "duration": 1.081
        },
        {
          "order": 3,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo02_03",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo02_03.mp3",
          "text": "So like\u2026 Mobile?",
          "duration": 2.089
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo02_04",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo02_04.mp3",
          "text": "Sure!",
          "duration": 1.116
        },
        {
          "order": 5,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo02_05",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo02_05.mp3",
          "text": "You don't know what I said do you",
          "duration": 2.067
        },
        {
          "order": 6,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo02_06",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo02_06.mp3",
          "text": "No!",
          "duration": 1.114
        },
        {
          "order": 7,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo02_07",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo02_07.mp3",
          "text": "This is gonna go great\u2026.",
          "duration": 1.747
        }
      ]
    },
    {
      "conversationId": "holliday_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo03_01",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo03_01.mp3",
          "text": "What does revenge feel like?",
          "duration": 2.188
        },
        {
          "order": 2,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo03_02",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo03_02.mp3",
          "text": "What do you mean?",
          "duration": 1.022
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo03_03",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo03_03.mp3",
          "text": "When I'm in the cube it's warm.  I like being in the cube.  You seem to like revenge so I wonder if it feels the same.",
          "duration": 7.39
        },
        {
          "order": 4,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo03_04",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo03_04.mp3",
          "text": "No Viscous.  It, um.  It doesn't feel warm.",
          "duration": 3.882
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo03_05",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo03_05.mp3",
          "text": "But it feels good",
          "duration": 1.479
        },
        {
          "order": 6,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo03_06",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo03_06.mp3",
          "text": "No.  It really doesn\u2019t.",
          "duration": 2.417
        },
        {
          "order": 7,
          "character": "Viscous",
          "audioFile": "viscous_match_start_astro_viscous_convo03_07",
          "audioUrl": "audio/viscous_match_start_astro_viscous_convo03_07.mp3",
          "text": "Then why do you want to live in it?",
          "duration": 1.904
        },
        {
          "order": 8,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo03_08",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo03_08.mp3",
          "text": "Because there's nothing else I can do about it.",
          "duration": 2.559
        },
        {
          "order": 8,
          "character": "Holliday",
          "audioFile": "astro_match_start_astro_viscous_convo03_08_02",
          "audioUrl": "audio/astro_match_start_astro_viscous_convo03_08_02.mp3",
          "text": "Because there's nothing else I can do about it.",
          "duration": 2.462
        }
      ]
    },
    {
      "conversationId": "bebop_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo01_01.mp3",
          "text": "Ms. Shelly sounds like a nice lady.",
          "duration": 2.602
        },
        {
          "order": 2,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo01_02",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo01_02.mp3",
          "text": "She is.",
          "duration": 1.11
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo01_03.mp3",
          "text": "I'm sorry she's sick.",
          "duration": 1.791
        },
        {
          "order": 4,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo01_04",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo01_04.mp3",
          "text": "Thank you,.",
          "duration": 1.266
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo01_05",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo01_05.mp3",
          "text": "Do you think she'd like being in The Cube?",
          "duration": 2.367
        },
        {
          "order": 6,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo01_06",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo01_06.mp3",
          "text": "You what, she might.  After the ritual, come over to say hi.  I'll make biscuts",
          "duration": 5.821
        },
        {
          "order": 7,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo01_07",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo01_07.mp3",
          "text": "I made a friend.",
          "duration": 1.676
        }
      ]
    },
    {
      "conversationId": "bebop_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo02_01",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo02_01.mp3",
          "text": "Hey Viscous.  I'm not organic, why does the cube heal me?",
          "duration": 4.187
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo02_02",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo02_02.mp3",
          "text": "We don't question the cube.",
          "duration": 1.789
        }
      ]
    },
    {
      "conversationId": "bebop_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo03_01",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo03_01.mp3",
          "text": "I hear Lash doesn't like you",
          "duration": 2.064
        },
        {
          "order": 2,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo03_02",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo03_02.mp3",
          "text": "He does not.",
          "duration": 1.528
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_bebop_viscous_convo03_03",
          "audioUrl": "audio/viscous_match_start_bebop_viscous_convo03_03.mp3",
          "text": "That must make you sad.",
          "duration": 1.672
        },
        {
          "order": 4,
          "character": "Bebop",
          "audioFile": "bebop_match_start_bebop_viscous_convo03_04",
          "audioUrl": "audio/bebop_match_start_bebop_viscous_convo03_04.mp3",
          "text": "Not particularly",
          "duration": 1.726
        }
      ]
    },
    {
      "conversationId": "dynamo_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_01.mp3",
          "text": "Well aren't you a facinating creature\u2026",
          "duration": 2.032
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_02",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_02.mp3",
          "text": "I think so.",
          "duration": 1.159
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_03.mp3",
          "text": "When the ritual is over I'd love to pick your brain.",
          "duration": 3.256
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_04",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_04.mp3",
          "text": "Please don't stab my face",
          "duration": 1.889
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo01_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo01_05.mp3",
          "text": "Oh!  It's an expression, it means to ask questions.",
          "duration": 3.459
        },
        {
          "order": 6,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo01_06",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo01_06.mp3",
          "text": "Oh, that sounds more fun.  OK!",
          "duration": 2.961
        }
      ]
    },
    {
      "conversationId": "dynamo_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo02_01",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo02_01.mp3",
          "text": "What happened to your body?",
          "duration": 1.45
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo02_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo02_02.mp3",
          "text": "Obliterated in an astral gate.",
          "duration": 1.808
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo02_03",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo02_03.mp3",
          "text": "That sounds upsetting.",
          "duration": 1.928
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo02_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo02_04.mp3",
          "text": "I do not recommend it.",
          "duration": 1.622
        }
      ]
    },
    {
      "conversationId": "dynamo_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_viscous_convo03_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_viscous_convo03_01.mp3",
          "text": "So this adversary\u2026",
          "duration": 1.919
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_dynamo_viscous_convo03_02",
          "audioUrl": "audio/viscous_match_start_dynamo_viscous_convo03_02.mp3",
          "text": "Is dangerous.  And it's only a matter of time before he tires of The Deep and comes for you on land.",
          "duration": 5.937
        }
      ]
    },
    {
      "conversationId": "lady geist_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo01_01.mp3",
          "text": "You're pretty.",
          "duration": 1.162
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo01_02",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo01_02.mp3",
          "text": "um.  Thanks.",
          "duration": 2.355
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo01_03.mp3",
          "text": "I match your arm.",
          "duration": 1.468
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo01_04",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo01_04.mp3",
          "text": "Yes Viscous.",
          "duration": 1.204
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo01_05",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo01_05.mp3",
          "text": "We're friends.",
          "duration": 1.593
        },
        {
          "order": 6,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo01_06",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo01_06.mp3",
          "text": "No Viscous.",
          "duration": 1.604
        }
      ]
    },
    {
      "conversationId": "lady geist_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo02_01",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo02_01.mp3",
          "text": "Do you like goo?",
          "duration": 1.361
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo02_02",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo02_02.mp3",
          "text": "No.",
          "duration": 0.916
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo02_03",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo02_03.mp3",
          "text": "I do!",
          "duration": 0.97
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo02_03_alt_01",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo02_03_alt_01.mp3",
          "text": "I do.",
          "duration": 1.028
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo02_04",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo02_04.mp3",
          "text": "Wonderful.",
          "duration": 1.124
        }
      ]
    },
    {
      "conversationId": "lady geist_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo03_01",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo03_01.mp3",
          "text": "I don't have a nose.  But if I did I bet your hair would smell like flowers.",
          "duration": 5.689
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_viscous_convo03_02",
          "audioUrl": "audio/ghost_match_start_ghost_viscous_convo03_02.mp3",
          "text": "It\u2026 kind of does actually.",
          "duration": 2.959
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_ghost_viscous_convo03_03",
          "audioUrl": "audio/viscous_match_start_ghost_viscous_convo03_03.mp3",
          "text": "Neat!",
          "duration": 1.039
        }
      ]
    },
    {
      "conversationId": "seven_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo01_01.mp3",
          "text": "Hello.",
          "duration": 0.95
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo01_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo01_02.mp3",
          "text": "Oh god it's talking to me",
          "duration": 1.966
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo01_03.mp3",
          "text": "I'm viscous",
          "duration": 1.561
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo01_04",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo01_04.mp3",
          "text": "I can see that.",
          "duration": 1.445
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo01_05",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo01_05.mp3",
          "text": "I'm made of goo.",
          "duration": 1.609
        },
        {
          "order": 6,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo01_06",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo01_06.mp3",
          "text": "This could be a nightmare.",
          "duration": 1.463
        }
      ]
    },
    {
      "conversationId": "seven_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo02_01",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo02_01.mp3",
          "text": "So what do you do?",
          "duration": 1.6
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo02_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo02_02.mp3",
          "text": "Strive for apotheosis",
          "duration": 1.915
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo02_03",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo02_03.mp3",
          "text": "That's a big word.",
          "duration": 1.901
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo02_04",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo02_04.mp3",
          "text": "Indeed.",
          "duration": 1.135
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo02_05",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo02_05.mp3",
          "text": "What's it mean?",
          "duration": 1.459
        },
        {
          "order": 6,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo02_06",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo02_06.mp3",
          "text": "Once we summon the patron you'll see for yourelf.",
          "duration": 3.085
        }
      ]
    },
    {
      "conversationId": "seven_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo03_01",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo03_01.mp3",
          "text": "So you say you're from The Deep",
          "duration": 2.437
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo03_02",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo03_02.mp3",
          "text": "Oh yes.",
          "duration": 1.135
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo03_03",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo03_03.mp3",
          "text": "And why are you here.",
          "duration": 1.527
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_gigawatt_viscous_convo03_04",
          "audioUrl": "audio/viscous_match_start_gigawatt_viscous_convo03_04.mp3",
          "text": "The adversary\u2026 he comes for The Deep.  And if I don't stop him, he'll come for everything.",
          "duration": 6.557
        },
        {
          "order": 5,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_viscous_convo03_05",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_viscous_convo03_05.mp3",
          "text": "There's more to you than I expected Viscous.",
          "duration": 2.762
        }
      ]
    },
    {
      "conversationId": "haze_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo01_01",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo01_01.mp3",
          "text": "Viscous, after the ritual I need you to tell me about The Adversary.",
          "duration": 4.715
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo01_02",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo01_02.mp3",
          "text": "But after the ritual The Adversary will be gone.",
          "duration": 3.143
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo01_03",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo01_03.mp3",
          "text": "Yes, but there may be others\u2026 and the OSIC needs to be prepared.",
          "duration": 5.025
        }
      ]
    },
    {
      "conversationId": "haze_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo02_01",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo02_01.mp3",
          "text": "You seem serious.",
          "duration": 1.893
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo02_02",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo02_02.mp3",
          "text": "I have a serious job.",
          "duration": 2.234
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo02_03",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo02_03.mp3",
          "text": "Do you ever have fun?",
          "duration": 1.573
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo02_04",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo02_04.mp3",
          "text": "Of course.",
          "duration": 1.57
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo02_05",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo02_05.mp3",
          "text": "What do you do?",
          "duration": 1.196
        },
        {
          "order": 6,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo02_06",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo02_06.mp3",
          "text": "I play the cello.",
          "duration": 1.935
        },
        {
          "order": 7,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo02_07",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo02_07.mp3",
          "text": "Neat!",
          "duration": 1.142
        }
      ]
    },
    {
      "conversationId": "haze_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo03_01",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo03_01.mp3",
          "text": "Thanks for your help Haze, not everyone takes the problems of The Deep seriously.",
          "duration": 4.934
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_viscous_convo03_02",
          "audioUrl": "audio/haze_match_start_haze_viscous_convo03_02.mp3",
          "text": "We don't live in a vaccum.  If there's a problem in The Deep it's only a matter of time before it's a problem on land.",
          "duration": 7.634
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_haze_viscous_convo03_03",
          "audioUrl": "audio/viscous_match_start_haze_viscous_convo03_03.mp3",
          "text": "Exactly",
          "duration": 1.279
        }
      ]
    },
    {
      "conversationId": "infernus_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo01_01.mp3",
          "text": "Do you always dress fancy or is it just for work?",
          "duration": 3.339
        },
        {
          "order": 2,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo01_02",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo01_02.mp3",
          "text": "Look good feel good, baby.",
          "duration": 2.029
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo01_03.mp3",
          "text": "I need a tie.",
          "duration": 1.586
        },
        {
          "order": 4,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo01_04",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo01_04.mp3",
          "text": "You're goddamn right you do.",
          "duration": 1.324
        }
      ]
    },
    {
      "conversationId": "infernus_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo02_01",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo02_01.mp3",
          "text": "How you liking New York?",
          "duration": 1.313
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo02_02",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo02_02.mp3",
          "text": "People watching is fun.",
          "duration": 1.895
        },
        {
          "order": 3,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo02_03",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo02_03.mp3",
          "text": "You should stop by Jezebel's sometime, if you like people watching you'll see all types there.",
          "duration": 5.092
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo02_04",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo02_04.mp3",
          "text": "What's that?",
          "duration": 1.09
        },
        {
          "order": 5,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo02_05",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo02_05.mp3",
          "text": "The bar my buddy Hank owns",
          "duration": 1.529
        },
        {
          "order": 6,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo02_06",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo02_06.mp3",
          "text": "Why isn't it called Hank's?",
          "duration": 2.558
        },
        {
          "order": 7,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo02_07",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo02_07.mp3",
          "text": "Long story.  I'll tell you later.",
          "duration": 2.155
        }
      ]
    },
    {
      "conversationId": "infernus_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo03_01",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo03_01.mp3",
          "text": "You're new here, right?",
          "duration": 1.012
        },
        {
          "order": 2,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo03_02",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo03_02.mp3",
          "text": "Yep",
          "duration": 0.746
        },
        {
          "order": 3,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo03_03",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo03_03.mp3",
          "text": "Can I give you some adivce?",
          "duration": 1.418
        },
        {
          "order": 4,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo03_04",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo03_04.mp3",
          "text": "Sure!",
          "duration": 1.055
        },
        {
          "order": 5,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo03_05",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo03_05.mp3",
          "text": "If Wraith invites you to play cards, say no.",
          "duration": 2.236
        },
        {
          "order": 6,
          "character": "Viscous",
          "audioFile": "viscous_match_start_inferno_viscous_convo03_06",
          "audioUrl": "audio/viscous_match_start_inferno_viscous_convo03_06.mp3",
          "text": "But that would be rude!",
          "duration": 1.707
        },
        {
          "order": 7,
          "character": "Infernus",
          "audioFile": "inferno_match_start_inferno_viscous_convo03_07",
          "audioUrl": "audio/inferno_match_start_inferno_viscous_convo03_07.mp3",
          "text": "Trust me.",
          "duration": 0.845
        }
      ]
    },
    {
      "conversationId": "grey talon_viscous_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo01_01",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo01_01.mp3",
          "text": "You look sad.",
          "duration": 1.326
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo01_02",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo01_02.mp3",
          "text": "I am.",
          "duration": 0.882
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo01_03",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo01_03.mp3",
          "text": "Do you want to spend time in the cube?  It's where I go when I'm sad.  Or injured.  Or just want to be in the cube.",
          "duration": 8.113
        },
        {
          "order": 4,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo01_04",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo01_04.mp3",
          "text": "Thank you for the offer Viscous.  I'm fine.",
          "duration": 2.899
        }
      ]
    },
    {
      "conversationId": "grey talon_viscous_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo02_01",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo02_01.mp3",
          "text": "The Baxter Society hunts monsters, right?",
          "duration": 2.813
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo02_02",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo02_02.mp3",
          "text": "They do.",
          "duration": 0.656
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo02_03",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo02_03.mp3",
          "text": "If we fail to summon The Patron, do you think they can help stop The Adversary.",
          "duration": 4.636
        },
        {
          "order": 4,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo02_04",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo02_04.mp3",
          "text": "If we fail to summon the Patron we'll probably be dead.",
          "duration": 3.188
        },
        {
          "order": 5,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo02_05",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo02_05.mp3",
          "text": "You'll probably be dead.  I'm goo.  I'll be fine.",
          "duration": 4.564
        },
        {
          "order": 6,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo02_06",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo02_06.mp3",
          "text": "*sigh* bring them my bow, they'll listen to what you have to say.",
          "duration": 5.104
        },
        {
          "order": 7,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo02_07",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo02_07.mp3",
          "text": "Thanks.",
          "duration": 1.099
        }
      ]
    },
    {
      "conversationId": "grey talon_viscous_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo03_01",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo03_01.mp3",
          "text": "At your fragile age I think you'll find the  cube to be quite helpful.",
          "duration": 4.055
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_orion_viscous_convo03_02",
          "audioUrl": "audio/orion_match_start_orion_viscous_convo03_02.mp3",
          "text": "I'm not fragile.",
          "duration": 1.354
        },
        {
          "order": 3,
          "character": "Viscous",
          "audioFile": "viscous_match_start_orion_viscous_convo03_03",
          "audioUrl": "audio/viscous_match_start_orion_viscous_convo03_03.mp3",
          "text": "No, you are.  But you lie to yourself because you're a human.",
          "duration": 4.004
        }
      ]
    }
  ]
}