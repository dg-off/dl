          "audioFile": "mirage_match_start_haze_mirage_convo02_02",
          "audioUrl": "audio/mirage_match_start_haze_mirage_convo02_02.mp3",
          "text": "The feeling's mutual.",
          "duration": 1.449
        }
      ]
    },
    {
