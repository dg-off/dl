          "audioFile": "haze_match_start_haze_mirage_convo01_02",
          "audioUrl": "audio/haze_match_start_haze_mirage_convo01_02.mp3",
          "text": "I'm not a politician Mirage, my approval will neither help nor hinder the Djinn's chances of buying Wyoming.",
          "duration": 6.894
        }
      ]
    },
    {
      "conversationId": "haze_mirage_convo02",
