{
  "conversations": [
    {
      "conversationId": "haze_lady geist_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_ghost_convo03_01",
          "audioUrl": "audio/haze_match_start_haze_ghost_convo03_01.mp3",
          "text": "Don't worry Lady Geist, I'm not here for you today.",
          "duration": 3.912
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_haze_ghost_convo03_02",
          "audioUrl": "audio/ghost_match_start_haze_ghost_convo03_02.mp3",
          "text": "Today?",
          "duration": 1.107
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_ghost_convo03_03",
          "audioUrl": "audio/haze_match_start_haze_ghost_convo03_03.mp3",
          "text": "Forget I said anything.",
          "duration": 2.379
        }
      ]
    },
    {
      "conversationId": "billy_lady geist_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_punkgoat_ghost_convo01_01",
          "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_01.mp3",
          "text": "What do I call you.",
          "duration": 1.767
        },
        {
          "order": 2,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_ghost_convo01_02",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo01_02.mp3",
          "text": "Not like you actually give a shit, but my name's Billy.",
          "duration": 2.732
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_punkgoat_ghost_convo01_03",
          "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_03.mp3",
          "text": "No self respecting man actually wants to be called Billy.",
          "duration": 3.839
        },
        {
          "order": 4,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_ghost_convo01_04",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo01_04.mp3",
          "text": "Oh so now you know me.",
          "duration": 1.68
        },
        {
          "order": 5,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_punkgoat_ghost_convo01_05",
          "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo01_05.mp3",
          "text": "Believe me William, I wish I didn't",
          "duration": 3.114
        }
      ]
    },
    {
      "conversationId": "billy_lady geist_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_ghost_convo02_01",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo02_01.mp3",
          "text": "When your ivory tower comes crashing down I hope you're under it.",
          "duration": 3.767
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_punkgoat_ghost_convo02_02",
          "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo02_02.mp3",
          "text": "Be as snide as you like, at the end of the day I'll be sleeping in my penthouse and you'll be chewing on a tin can wondering where your life went wrong",
          "duration": 10.0
        },
        {
          "order": 3,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_ghost_convo02_03",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_ghost_convo02_03.mp3",
          "text": "Oh I know exaclty where my life went wrong lady.",
          "duration": 2.82
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_punkgoat_ghost_convo02_04",
          "audioUrl": "audio/ghost_match_start_punkgoat_ghost_convo02_04.mp3",
          "text": "impressive.  I'm sure you were spoiled for choice.",
          "duration": 3.679
        }
      ]
    }
  ]
}