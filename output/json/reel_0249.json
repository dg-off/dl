      ]
    },
    {
      "conversationId": "billy_vyper_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_01",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_01.mp3",
          "text": "Don't think I've seen you since you got pinched.",
          "duration": 2.108
        },
        {
          "order": 2,
          "character": "Vyper",
          "audioFile": "viper_match_start_punkgoat_viper_convo01_02",
          "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_02.mp3",
          "text": "That's cause you never bothered to visit.  If I didn't know better I'd think you stop caring.",
          "duration": 5.322
        },
        {
          "order": 3,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_03",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_03.mp3",
          "text": "I just assumed you busted out.",
          "duration": 1.737
        },
        {
          "order": 4,
          "character": "Vyper",
          "audioFile": "viper_match_start_punkgoat_viper_convo01_04",
          "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_04.mp3",
          "text": "You're looking good.  New jacket?",
          "duration": 2.616
        },
        {
          "order": 5,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_05",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_05.mp3",
          "text": "You like it?",
          "duration": 0.715
        },
        {
          "order": 6,
          "character": "Vyper",
          "audioFile": "viper_match_start_punkgoat_viper_convo01_06",
          "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_06.mp3",
          "text": "I'll like it even better on the ground of a dark alley",
          "duration": 2.455
        },
        {
          "order": 7,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_07",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_07.mp3",
          "text": "Oh I know where we're going after the ritual.",
          "duration": 2.436
        },
        {
          "order": 8,
          "character": "Vyper",
          "audioFile": "viper_match_start_punkgoat_viper_convo01_08",
          "audioUrl": "audio/viper_match_start_punkgoat_viper_convo01_08.mp3",
          "text": "You mind if I call you Lash?",
          "duration": 1.71
        },
        {
          "order": 9,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_viper_convo01_09",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_viper_convo01_09.mp3",
          "text": "I don't give a shit.",
          "duration": 1.201
        }
      ]
    },
    {
      "conversationId": "billy_wraith_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_wraith_convo01_01",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_wraith_convo01_01.mp3",
          "text": "Oh great, I'm with the paper gangster.",
          "duration": 2.594
        },
        {
          "order": 2,
          "character": "Wraith",
          "audioFile": "wraith_match_start_punkgoat_wraith_convo01_02",
          "audioUrl": "audio/wraith_match_start_punkgoat_wraith_convo01_02.mp3",
          "text": "What did you call me.",
          "duration": 1.533
        },
        {
          "order": 3,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_wraith_convo01_03",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_wraith_convo01_03.mp3",
          "text": "Lady; you don't want to be a crime lord, you want to be mayor.  And while you're kissing babies the 7th Moon is going to eat your lunch.",
          "duration": 7.23
        },
        {
          "order": 4,
          "character": "Wraith",
          "audioFile": "wraith_match_start_punkgoat_wraith_convo01_04",
          "audioUrl": "audio/wraith_match_start_punkgoat_wraith_convo01_04.mp3",
          "text": "Oh, you're a fan of the 7th Moon.",
          "duration": 2.518
        },
        {
          "order": 5,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_wraith_convo01_05",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_wraith_convo01_05.mp3",
          "text": "Easy easy  I didn't say that",
          "duration": 2.263
        },
        {
          "order": 6,
          "character": "Wraith",
          "audioFile": "wraith_match_start_punkgoat_wraith_convo01_06",
          "audioUrl": "audio/wraith_match_start_punkgoat_wraith_convo01_06.mp3",
          "text": "That's what I thought.",
          "duration": 1.033
        }
      ]
    }
