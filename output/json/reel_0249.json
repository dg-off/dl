          "duration": 3.709
        },
        {
          "order": 3,
          "character": "Ivy",
          "audioFile": "tengu_match_start_punkgoat_tengu_convo03_03",
          "audioUrl": "audio/tengu_match_start_punkgoat_tengu_convo03_03.mp3",
          "text": "What?  People ask about that?  That'd be crazy.",
          "duration": 3.532
