          "audioUrl": "audio/tengu_match_start_punkgoat_tengu_convo03_01.mp3",
          "text": "Hey, Billy\u2026 so I was wondering\u2026",
          "duration": 3.08
        },
        {
          "order": 2,
          "character": "Billy",
          "audioFile": "punkgoat_match_start_punkgoat_tengu_convo03_02",
          "audioUrl": "audio/punkgoat_match_start_punkgoat_tengu_convo03_02.mp3",
