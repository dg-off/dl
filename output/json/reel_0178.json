      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_gigawatt_kelvin_convo01_01",
          "audioUrl": "audio/kelvin_match_start_gigawatt_kelvin_convo01_01.mp3",
          "text": "Why do you hate me.",
          "duration": 1.776
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo01_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo01_02.mp3",
          "text": "The patron will reveal all.",
          "duration": 2.097
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_gigawatt_kelvin_convo01_03",
          "audioUrl": "audio/kelvin_match_start_gigawatt_kelvin_convo01_03.mp3",
          "text": "And then what.",
          "duration": 1.31
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo01_04",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo01_04.mp3",
          "text": "Then I let you stew on when I'll come to kill you.",
          "duration": 2.803
        }
      ]
    },
    {
      "conversationId": "kelvin_seven_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo02_01",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo02_01.mp3",
          "text": "Don't worry Kelvin, I won't let you die.",
          "duration": 3.364
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_gigawatt_kelvin_convo02_02",
          "audioUrl": "audio/kelvin_match_start_gigawatt_kelvin_convo02_02.mp3",
          "text": "I thought you hated me",
          "duration": 2.495
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo02_03",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo02_03.mp3",
          "text": "I do.  But if anyone is going to kill you, it's going to be me.",
          "duration": 4.504
        }
      ]
    },
    {
      "conversationId": "kelvin_seven_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_gigawatt_kelvin_convo03_01",
          "audioUrl": "audio/kelvin_match_start_gigawatt_kelvin_convo03_01.mp3",
          "text": "No barbed words before the ritual?",
          "duration": 3.024
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo03_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo03_02.mp3",
          "text": "Kelvin: whatever it is you are now is a pale imitation of the man you were.  To mock someone in your state of frailty is beneath me.",
          "duration": 9.342
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_kelvin_convo03_02_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_kelvin_convo03_02_02.mp3",
          "text": "Kelvin, whatever it is you are now is a pale imitation of the man you were. To mock someone in your state of frailty is beneath me.",
