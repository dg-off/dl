{
  "conversations": [
    {
      "conversationId": "lady geist_mcginnis_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo01_01",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo01_01.mp3",
          "text": "I don't know how you do it.",
          "duration": 1.425
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo01_02",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo01_02.mp3",
          "text": "You'd be surprised what you're capable of when the only other option's death.",
          "duration": 4.09
        },
        {
          "order": 3,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo01_03",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo01_03.mp3",
          "text": "Oh I wasn't talking about murder, I was talking about pretending to be interested in people at fundraisers.  I've seen you work the room at Fairfax's parties, it's something else.",
          "duration": 8.593
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo01_04",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo01_04.mp3",
          "text": "Oh, Johann dragged me to hundred's of those before, it's second nature.",
          "duration": 4.9
        },
        {
          "order": 5,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo01_05",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo01_05.mp3",
          "text": "That your husband?",
          "duration": 1.015
        },
        {
          "order": 6,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo01_06",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo01_06.mp3",
          "text": "Was.",
          "duration": 0.766
        }
      ]
    },
    {
      "conversationId": "lady geist_mcginnis_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo02_01",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo02_01.mp3",
          "text": "Ugh, you smell of motor oil and labor.",
          "duration": 3.181
        },
        {
          "order": 2,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo02_02",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo02_02.mp3",
          "text": "That's because I work for a living.",
          "duration": 1.983
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo02_03",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo02_03.mp3",
          "text": "How fun for you.",
          "duration": 1.441
        },
        {
          "order": 4,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo02_04",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo02_04.mp3",
          "text": "Yeah, turns out being a human being is good for the soul, you should try it sometime.",
          "duration": 4.189
        }
      ]
    },
    {
      "conversationId": "lady geist_mcginnis_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo03_01",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo03_01.mp3",
          "text": "You're dressed practically.",
          "duration": 1.521
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo03_02",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo03_02.mp3",
          "text": "Ah.  Wit.",
          "duration": 1.632
        },
        {
          "order": 3,
          "character": "Mcginnis",
          "audioFile": "forge_match_start_ghost_forge_convo03_03",
          "audioUrl": "audio/forge_match_start_ghost_forge_convo03_03.mp3",
          "text": "Seriously, how do you think you're going to fight in that?",
          "duration": 2.148
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_forge_convo03_04",
          "audioUrl": "audio/ghost_match_start_ghost_forge_convo03_04.mp3",
          "text": "Your concerns are as unwanted as they are unneeded.  Watch and learn.",
          "duration": 4.854
        }
      ]
    }
  ]
}