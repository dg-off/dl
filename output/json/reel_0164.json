        },
        {
          "order": 5,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo03_05",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo03_05.mp3",
          "text": "And so our friendship begins.",
          "duration": 2.899
        }
      ]
    },
    {
      "conversationId": "lady geist_lash_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Lash",
          "audioFile": "lash_match_start_ghost_lash_convo01_01",
          "audioUrl": "audio/lash_match_start_ghost_lash_convo01_01.mp3",
          "text": "Well take a look at Green Arm Sally.",
          "duration": 2.651
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_lash_convo01_02",
          "audioUrl": "audio/ghost_match_start_ghost_lash_convo01_02.mp3",
          "text": "Don't talk to me.",
          "duration": 1.464
        },
        {
          "order": 3,
          "character": "Lash",
          "audioFile": "lash_match_start_ghost_lash_convo01_03",
          "audioUrl": "audio/lash_match_start_ghost_lash_convo01_03.mp3",
          "text": "That's fine by me, I'm happy just looking.",
          "duration": 2.671
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_lash_convo01_04",
          "audioUrl": "audio/ghost_match_start_ghost_lash_convo01_04.mp3",
          "text": "Whenever I decide to kill you, just remember it's because of this conversation.",
          "duration": 4.587
        },
        {
          "order": 5,
          "character": "Lash",
          "audioFile": "lash_match_start_ghost_lash_convo01_05",
          "audioUrl": "audio/lash_match_start_ghost_lash_convo01_05.mp3",
          "text": "It's a date.",
          "duration": 1.353
        }
      ]
    },
    {
      "conversationId": "lady geist_lash_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_lash_convo02_01",
          "audioUrl": "audio/ghost_match_start_ghost_lash_convo02_01.mp3",
          "text": "Tell me you're competent.",
          "duration": 1.728
        },
        {
          "order": 2,
          "character": "Lash",
          "audioFile": "lash_match_start_ghost_lash_convo02_02",
          "audioUrl": "audio/lash_match_start_ghost_lash_convo02_02.mp3",
          "text": "Compotent?  No. I'm god's gift to combat.",
          "duration": 3.438
        },
        {
          "order": 3,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_lash_convo02_03",
          "audioUrl": "audio/ghost_match_start_ghost_lash_convo02_03.mp3",
          "text": "I can't tell if you're delusional or appropiately arrogant.",
          "duration": 3.526
        },
        {
          "order": 4,
          "character": "Lash",
          "audioFile": "lash_match_start_ghost_lash_convo02_04",
          "audioUrl": "audio/lash_match_start_ghost_lash_convo02_04.mp3",
          "text": "Yes.",
          "duration": 0.918
        }
      ]
    }
  ]
