        {
          "order": 3,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_ghost_krill_convo03_03",
          "audioUrl": "audio/krill_match_start_ghost_krill_convo03_03.mp3",
          "text": "It does.  It also plays a critical role in your survival so perhaps we should try that again.  It's nice to meet you Lady Geist.",
          "duration": 9.973
        },
        {
          "order": 4,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_ghost_krill_convo03_04",
          "audioUrl": "audio/ghost_match_start_ghost_krill_convo03_04.mp3",
          "text": "Hello.",
