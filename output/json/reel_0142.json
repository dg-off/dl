        {
          "order": 3,
          "character": "Venator",
          "audioFile": "priest_match_start_fencer_priest_convo02_03",
          "audioUrl": "audio/priest_match_start_fencer_priest_convo02_03.mp3",
          "text": "Young man, I don't care about the circumstances of your birth, I care about who you are.  I don't give a damn if you look like a monster\u2026. But if you act like one I will put you down.",
          "duration": 10.568
        },
