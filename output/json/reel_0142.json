          "audioFile": "fencer_match_start_fencer_priest_convo02_04",
          "audioUrl": "audio/fencer_match_start_fencer_priest_convo02_04.mp3",
          "text": "Yeah I definitely don't trust you.",
          "duration": 2.118
        }
      ]
    },
