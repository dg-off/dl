{
  "conversations": [
    {
      "conversationId": "ivy_kelvin_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo01_01",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo01_01.mp3",
          "text": "You know I could use someone like you on one of my expeditions.",
          "duration": 4.196
        },
        {
          "order": 2,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo01_02",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo01_02.mp3",
          "text": "Thanks for the offer sir, but I don't think I could be away from the Arroyo's that long.",
          "duration": 4.649
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo01_03",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo01_03.mp3",
          "text": "If you change your mind let me know.",
          "duration": 2.737
        }
      ]
    },
    {
      "conversationId": "ivy_kelvin_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo02_01",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo02_01.mp3",
          "text": "Mr. Kelvin?",
          "duration": 1.423
        },
        {
          "order": 2,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo02_02",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo02_02.mp3",
          "text": "Yes?",
          "duration": 0.946
        },
        {
          "order": 3,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo02_03",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo02_03.mp3",
          "text": "I know this is an awkward time to ask, but when this is over would you be willing to talk to my little brother?  He's a big fan of your adventure stories.",
          "duration": 8.602
        },
        {
          "order": 4,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo02_04",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo02_04.mp3",
          "text": "Of course Ivy.",
          "duration": 1.983
        }
      ]
    },
    {
      "conversationId": "ivy_kelvin_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo03_01",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo03_01.mp3",
          "text": "You seem troubled.",
          "duration": 1.584
        },
        {
          "order": 2,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo03_02",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo03_02.mp3",
          "text": "I always get a little nerous before I get shot at.",
          "duration": 3.423
        },
        {
          "order": 3,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo03_03",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo03_03.mp3",
          "text": "Me too.",
          "duration": 1.177
        },
        {
          "order": 4,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo03_04",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo03_04.mp3",
          "text": "You don't look nervous.",
          "duration": 1.572
        },
        {
          "order": 5,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_tengu_kelvin_convo03_05",
          "audioUrl": "audio/kelvin_match_start_tengu_kelvin_convo03_05.mp3",
          "text": "I'm already dead so the stakes are a little lower",
          "duration": 2.946
        },
        {
          "order": 6,
          "character": "Ivy",
          "audioFile": "tengu_match_start_tengu_kelvin_convo03_06",
          "audioUrl": "audio/tengu_match_start_tengu_kelvin_convo03_06.mp3",
          "text": "Makes sense.",
          "duration": 0.919
        }
      ]
    }
  ]
}