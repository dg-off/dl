      "conversationId": "apollo_haze_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_haze_convo03_01",
          "audioUrl": "audio/fencer_match_start_fencer_haze_convo03_01.mp3",
          "text": "Are you here for the OSIC or yourself?",
          "duration": 2.817
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_fencer_haze_convo03_02",
          "audioUrl": "audio/haze_match_start_fencer_haze_convo03_02.mp3",
          "text": "Either you're asking me to tell you classified information or to bare my soul to a teenager.  I'm not sure which one is more absurd.",
          "duration": 9.652
        },
        {
          "order": 3,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_haze_convo03_03",
          "audioUrl": "audio/fencer_match_start_fencer_haze_convo03_03.mp3",
          "text": "No need to be rude.",
          "duration": 1.266
        }
      ]
    },
    {
      "conversationId": "apollo_infernus_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_inferno_convo01_01",
          "audioUrl": "audio/fencer_match_start_fencer_inferno_convo01_01.mp3",
          "text": "Infernus, I want you to know that I'm approachable. I don't expect you to address me by my formal title.",
          "duration": 4.837
        },
        {
          "order": 2,
          "character": "Infernus",
          "audioFile": "inferno_match_start_fencer_inferno_convo01_02",
          "audioUrl": "audio/inferno_match_start_fencer_inferno_convo01_02.mp3",
          "text": "That's great cause I don't know who the hell you are.",
          "duration": 3.096
        },
        {
          "order": 3,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_inferno_convo01_03",
          "audioUrl": "audio/fencer_match_start_fencer_inferno_convo01_03.mp3",
          "text": "Excuse me?",
          "duration": 1.488
        },
        {
          "order": 4,
          "character": "Infernus",
          "audioFile": "inferno_match_start_fencer_inferno_convo01_04",
          "audioUrl": "audio/inferno_match_start_fencer_inferno_convo01_04.mp3",
          "text": "This is gonna shock you, but I'm a grown ass man\u2026 I don't hang out with kids from Blackmore Academy: I kick 'em out of my bar.",
          "duration": 7.035
        },
        {
          "order": 5,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_inferno_convo01_05",
          "audioUrl": "audio/fencer_match_start_fencer_inferno_convo01_05.mp3",
          "text": "But you're Ixian.",
          "duration": 1.411
        },
        {
          "order": 6,
          "character": "Infernus",
          "audioFile": "inferno_match_start_fencer_inferno_convo01_06",
          "audioUrl": "audio/inferno_match_start_fencer_inferno_convo01_06.mp3",
          "text": "I'm a New Yorker, baby.",
          "duration": 1.578
        }
      ]
    },
    {
      "conversationId": "apollo_infernus_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_inferno_convo02_01",
          "audioUrl": "audio/fencer_match_start_fencer_inferno_convo02_01.mp3",
          "text": "It's nice to fight alongside a fellow Ixian",
          "duration": 2.557
        },
        {
          "order": 2,
          "character": "Infernus",
          "audioFile": "inferno_match_start_fencer_inferno_convo02_02",
          "audioUrl": "audio/inferno_match_start_fencer_inferno_convo02_02.mp3",
          "text": "Ixian.  Human.  Chupacabra.  Makes no differnece to me.",
          "duration": 4.88
        },
        {
          "order": 3,
          "character": "Apollo",
          "audioFile": "fencer_match_start_fencer_inferno_convo02_03",
          "audioUrl": "audio/fencer_match_start_fencer_inferno_convo02_03.mp3",
          "text": "Have you been here so long that you forgot where you came from?",
          "duration": 3.342
        },
        {
          "order": 4,
          "character": "Infernus",
          "audioFile": "inferno_match_start_fencer_inferno_convo02_04",
          "audioUrl": "audio/inferno_match_start_fencer_inferno_convo02_04.mp3",
          "text": "I know where I'm from\u2026and that's why I don't give a shit.",
          "duration": 3.442
        }
      ]
    }
  ]
}