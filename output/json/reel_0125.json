{
  "conversations": [
    {
      "conversationId": "dynamo_grey talon_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo02_01",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo02_01.mp3",
          "text": "You have courage professor",
          "duration": 1.626
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_orion_convo02_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_orion_convo02_02.mp3",
          "text": "No more than most",
          "duration": 1.071
        },
        {
          "order": 3,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo02_03",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo02_03.mp3",
          "text": "A lot more than most.  You endured something horrible and yet you live your life like it's going to be ok.",
          "duration": 5.824
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_orion_convo02_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_orion_convo02_04.mp3",
          "text": "It was either that or give into despair, and that's not really an option is it?",
          "duration": 4.027
        },
        {
          "order": 5,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo02_05",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo02_05.mp3",
          "text": "I wish I could be like you.",
          "duration": 2.135
        }
      ]
    },
    {
      "conversationId": "dynamo_grey talon_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo03_01",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo03_01.mp3",
          "text": "Have you been to Ixia professor?",
          "duration": 2.104
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_orion_convo03_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_orion_convo03_02.mp3",
          "text": "I won't lie - after what happened to my body I decided to stay clear of Astral Gates, but I hear that South Ixia is beautiful.",
          "duration": 7.483
        },
        {
          "order": 3,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo03_03",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo03_03.mp3",
          "text": "It is.",
          "duration": 0.836
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_orion_convo03_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_orion_convo03_04.mp3",
          "text": "Maybe when this is over we could takes the wives on a couples trip.",
          "duration": 3.166
        },
        {
          "order": 5,
          "character": "Grey talon",
          "audioFile": "orion_match_start_dynamo_orion_convo03_05",
          "audioUrl": "audio/orion_match_start_dynamo_orion_convo03_05.mp3",
          "text": "I don't think so, but thank you for the offer.",
          "duration": 2.639
        }
      ]
    },
    {
      "conversationId": "dynamo_shiv_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Shiv",
          "audioFile": "shiv_match_start_dynamo_shiv_convo01_01",
          "audioUrl": "audio/shiv_match_start_dynamo_shiv_convo01_01.mp3",
          "text": "Hold 'em for me Professor, and I'll take care of the rest.",
          "duration": 3.08
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_shiv_convo01_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_shiv_convo01_02.mp3",
          "text": "Sounds like a plan.",
          "duration": 1.139
        }
      ]
    }
  ]
