          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_ghost_convo01_03",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_ghost_convo01_03.mp3",
          "text": "I know that faustian bargins rarely have happy endings.",
          "duration": 3.239
        }
      ]
    },
    {
      "conversationId": "lady geist_seven_convo02",
      "lines": [
