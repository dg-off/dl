          "audioUrl": "audio/gigawatt_match_start_gigawatt_ghost_convo01_01.mp3",
          "text": "I see you're finally addressing your Oathkeeper problem.",
          "duration": 3.04
        },
        {
          "order": 2,
          "character": "Lady geist",
          "audioFile": "ghost_match_start_gigawatt_ghost_convo01_02",
          "audioUrl": "audio/ghost_match_start_gigawatt_ghost_convo01_02.mp3",
          "text": "What do you know about Oathkeeper.",
