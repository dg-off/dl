          "character": "Lady geist",
          "audioFile": "ghost_match_start_gigawatt_ghost_convo02_03",
          "audioUrl": "audio/ghost_match_start_gigawatt_ghost_convo02_03.mp3",
          "text": "It's the only thing to worry about; if I die I won't have to deal with the shame of associating with you.",
