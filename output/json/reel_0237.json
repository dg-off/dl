        {
          "order": 5,
          "character": "Silver",
          "audioFile": "werewolf_match_start_necro_werewolf_convo01_05",
          "audioUrl": "audio/werewolf_match_start_necro_werewolf_convo01_05.mp3",
          "text": "I'm pretty consistent.",
          "duration": 1.547
        },
        {
          "order": 6,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_werewolf_convo01_06",
          "audioUrl": "audio/necro_match_start_necro_werewolf_convo01_06.mp3",
          "text": "I think I don't hate you.",
          "duration": 1.274
        },
        {
          "order": 7,
          "character": "Silver",
          "audioFile": "werewolf_match_start_necro_werewolf_convo01_07",
          "audioUrl": "audio/werewolf_match_start_necro_werewolf_convo01_07.mp3",
          "text": "I think I don't hate you too.",
          "duration": 1.817
        }
      ]
    },
    {
      "conversationId": "graves_silver_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_werewolf_convo02_01",
          "audioUrl": "audio/necro_match_start_necro_werewolf_convo02_01.mp3",
          "text": "You like being a werewolf?",
          "duration": 1.158
        },
        {
          "order": 2,
          "character": "Silver",
          "audioFile": "werewolf_match_start_necro_werewolf_convo02_02",
          "audioUrl": "audio/werewolf_match_start_necro_werewolf_convo02_02.mp3",
          "text": "I don't know.",
          "duration": 0.917
        },
        {
          "order": 3,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_werewolf_convo02_03",
          "audioUrl": "audio/necro_match_start_necro_werewolf_convo02_03.mp3",
          "text": "You don't know?",
