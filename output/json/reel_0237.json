        {
          "order": 4,
          "character": "Graves",
          "audioFile": "necro_match_start_necro_werewolf_convo01_04",
          "audioUrl": "audio/necro_match_start_necro_werewolf_convo01_04.mp3",
          "text": "Are you always a bitch, or is this something special just for me?",
