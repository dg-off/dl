{
  "conversations": [
    {
      "conversationId": "mo&krill_wraith_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo01_01",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo01_01.mp3",
          "text": "Thanks for coming along boys.",
          "duration": 1.456
        },
        {
          "order": 2,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_krill_wraith_convo01_02",
          "audioUrl": "audio/krill_match_start_krill_wraith_convo01_02.mp3",
          "text": "How could we say no to forced conscription",
          "duration": 3.366
        },
        {
          "order": 3,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo01_03",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo01_03.mp3",
          "text": "Hey, of all the people I could call markers on I chose you, and that should count for something.",
          "duration": 5.784
        }
      ]
    },
    {
      "conversationId": "mo&krill_wraith_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo02_01",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo02_01.mp3",
          "text": "I almost feel sorry for the poor bastards waiting for us in the lane.",
          "duration": 3.709
        },
        {
          "order": 2,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_krill_wraith_convo02_02",
          "audioUrl": "audio/krill_match_start_krill_wraith_convo02_02.mp3",
          "text": "Wraith.  Is that compassion I hear?",
          "duration": 3.787
        },
        {
          "order": 3,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo02_03",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo02_03.mp3",
          "text": "I said almost.",
          "duration": 2.027
        }
      ]
    },
    {
      "conversationId": "mo&krill_wraith_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_krill_wraith_convo03_01",
          "audioUrl": "audio/krill_match_start_krill_wraith_convo03_01.mp3",
          "text": "Wraith,  If things go bad and we-",
          "duration": 3.048
        },
        {
          "order": 2,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo03_02",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo03_02.mp3",
          "text": "Boys we don't talk about losing at the table.",
          "duration": 2.193
        },
        {
          "order": 3,
          "character": "Mo&krill",
          "audioFile": "krill_match_start_krill_wraith_convo03_03",
          "audioUrl": "audio/krill_match_start_krill_wraith_convo03_03.mp3",
          "text": "I'm serious.  Friends come rarely in our line of work.  And it's an honor to be counted amongst yours.",
          "duration": 7.303
        },
        {
          "order": 4,
          "character": "Wraith",
          "audioFile": "wraith_match_start_krill_wraith_convo03_04",
          "audioUrl": "audio/wraith_match_start_krill_wraith_convo03_04.mp3",
          "text": "Feeling's mutual.  Now let's summon a god.",
          "duration": 3.3
        }
      ]
    }
  ]
}