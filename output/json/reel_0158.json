{
  "conversations": [
    {
      "conversationId": "lash_victor_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Lash",
          "audioFile": "lash_match_start_frank_lash_convo03_01",
          "audioUrl": "audio/lash_match_start_frank_lash_convo03_01.mp3",
          "text": "Here's the plan corpseboy, you draw their fire, and I'll swing in and save the day.",
          "duration": 5.316
        },
        {
          "order": 2,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_lash_convo03_02",
          "audioUrl": "audio/frank_match_start_frank_lash_convo03_02.mp3",
          "text": "by the time you \"save the day\" they'll be laughing over my dead body.",
          "duration": 3.684
        },
        {
          "order": 3,
          "character": "Lash",
          "audioFile": "lash_match_start_frank_lash_convo03_03",
          "audioUrl": "audio/lash_match_start_frank_lash_convo03_03.mp3",
          "text": "Exactly.  That's when The Lash catches them flatfooted.",
          "duration": 4.308
        },
        {
          "order": 4,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_lash_convo03_04",
          "audioUrl": "audio/frank_match_start_frank_lash_convo03_04.mp3",
          "text": "What good does that do me?",
          "duration": 1.585
        },
        {
          "order": 5,
          "character": "Lash",
          "audioFile": "lash_match_start_frank_lash_convo03_05",
          "audioUrl": "audio/lash_match_start_frank_lash_convo03_05.mp3",
          "text": "It gives your sad life meaning.  And that should be enough.",
          "duration": 3.747
        }
      ]
    },
    {
      "conversationId": "grey talon_victor_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo01_01",
          "audioUrl": "audio/frank_match_start_frank_orion_convo01_01.mp3",
          "text": "You're hurting.",
          "duration": 1.112
        },
        {
          "order": 2,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo01_02",
          "audioUrl": "audio/orion_match_start_frank_orion_convo01_02.mp3",
          "text": "I'm old, of course I'm hurting.",
          "duration": 3.048
        },
        {
          "order": 3,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo01_03",
          "audioUrl": "audio/frank_match_start_frank_orion_convo01_03.mp3",
          "text": "I'm not talking about your body.",
          "duration": 1.801
        }
      ]
    },
    {
      "conversationId": "grey talon_victor_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo02_01",
          "audioUrl": "audio/orion_match_start_frank_orion_convo02_01.mp3",
          "text": "I'll support you the best that I can, but I probably won't be charging in with you.",
          "duration": 4.805
        },
        {
          "order": 2,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo02_02",
          "audioUrl": "audio/frank_match_start_frank_orion_convo02_02.mp3",
          "text": "That's ok, I'm used to working alone.",
          "duration": 2.601
        },
        {
          "order": 3,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo02_03",
          "audioUrl": "audio/orion_match_start_frank_orion_convo02_03.mp3",
          "text": "You're not working alone.",
          "duration": 1.51
        },
        {
          "order": 4,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo02_04",
          "audioUrl": "audio/frank_match_start_frank_orion_convo02_04.mp3",
          "text": "Oh. I'll just die alone.",
          "duration": 1.298
        },
        {
          "order": 5,
          "character": "Grey talon",
          "audioFile": "orion_match_start_frank_orion_convo02_05",
          "audioUrl": "audio/orion_match_start_frank_orion_convo02_05.mp3",
          "text": "Basically.",
          "duration": 0.878
        },
        {
          "order": 6,
          "character": "Victor",
          "audioFile": "frank_match_start_frank_orion_convo02_06",
          "audioUrl": "audio/frank_match_start_frank_orion_convo02_06.mp3",
          "text": "Great.",
          "duration": 0.56
        }
      ]
    }
  ]
