{
  "conversations": [
    {
      "conversationId": "lash_seven_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo01_01",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo01_01.mp3",
          "text": "Word on the street is that you're some kind of boogeyman.",
          "duration": 3.12
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo01_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo01_02.mp3",
          "text": "I'm not interested in chit-chat.",
          "duration": 1.783
        },
        {
          "order": 3,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo01_03",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo01_03.mp3",
          "text": "That's fine.  The Lash knows how to carry a conversation.",
          "duration": 3.196
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo01_04",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo01_04.mp3",
          "text": "There is no conversation.",
          "duration": 2.206
        },
        {
          "order": 5,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo01_05",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo01_05.mp3",
          "text": "The Lash does it again\u2026",
          "duration": 2.027
        }
      ]
    },
    {
      "conversationId": "lash_seven_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo02_01",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo02_01.mp3",
          "text": "They say you have quite the ego.",
          "duration": 1.84
        },
        {
          "order": 2,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo02_02",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo02_02.mp3",
          "text": "Mediocre people say lots of unintelligent things.",
          "duration": 2.824
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo02_03",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo02_03.mp3",
          "text": "On this we can agree.",
          "duration": 1.621
        }
      ]
    },
    {
      "conversationId": "lash_seven_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo03_01",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo03_01.mp3",
          "text": "You're the pit-fighter, yes?",
          "duration": 1.626
        },
        {
          "order": 2,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo03_02",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo03_02.mp3",
          "text": "You mis-pronounced champion.",
          "duration": 2.409
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo03_03",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo03_03.mp3",
          "text": "How silly of me.",
          "duration": 1.371
        },
        {
          "order": 4,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo03_04",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo03_04.mp3",
          "text": "Mistakes happen, glowstick.",
          "duration": 2.023
        },
        {
          "order": 5,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo03_05",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo03_05.mp3",
          "text": "What did you call me?",
          "duration": 1.307
        },
        {
          "order": 6,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo03_06",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo03_06.mp3",
          "text": "Glowstick.  It's your new nickname.",
          "duration": 2.66
        },
        {
          "order": 7,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo03_07",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo03_07.mp3",
          "text": "Call me that again and I will pop your eyes like grapes.",
          "duration": 3.692
        },
        {
          "order": 7,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_gigawatt_lash_convo03_07_02",
          "audioUrl": "audio/gigawatt_match_start_gigawatt_lash_convo03_07_02.mp3",
          "text": "Call me that again, and I will pop your eyes like grapes.",
          "duration": 4.251
        },
        {
          "order": 8,
          "character": "Lash",
          "audioFile": "lash_match_start_gigawatt_lash_convo03_08",
          "audioUrl": "audio/lash_match_start_gigawatt_lash_convo03_08.mp3",
          "text": "Seven it is.",
          "duration": 1.299
        }
      ]
    }
  ]
