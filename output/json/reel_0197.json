        },
        {
          "order": 2,
          "character": "Wraith",
          "audioFile": "wraith_match_start_haze_wraith_convo03_02",
          "audioUrl": "audio/wraith_match_start_haze_wraith_convo03_02.mp3",
          "text": "Damn right we will.",
          "duration": 1.298
        }
      ]
