{
  "conversations": [
    {
      "conversationId": "haze_vindicta_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo01_01",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo01_01.mp3",
          "text": "Are you interested in joining the OSIC?",
          "duration": 3.197
        },
        {
          "order": 2,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo01_02",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo01_02.mp3",
          "text": "I think I've had my fill of state sanctioned murder.",
          "duration": 3.129
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo01_03",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo01_03.mp3",
          "text": "So that's a no.",
          "duration": 1.881
        },
        {
          "order": 4,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo01_04",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo01_04.mp3",
          "text": "Emphatically",
          "duration": 1.182
        }
      ]
    },
    {
      "conversationId": "haze_vindicta_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo02_01",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo02_01.mp3",
          "text": "How can you work for them?",
          "duration": 1.538
        },
        {
          "order": 2,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo02_02",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo02_02.mp3",
          "text": "I love my country.",
          "duration": 1.99
        },
        {
          "order": 3,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo02_03",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo02_03.mp3",
          "text": "I don't know why I'm bothering to reason with a zealot.",
          "duration": 2.608
        },
        {
          "order": 4,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo02_04",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo02_04.mp3",
          "text": "I'm not a zealot.  The OSIC isn't perfect, and neither is the world.  You of all people should understand that the ends justify the means.",
          "duration": 9.494
        }
      ]
    },
    {
      "conversationId": "haze_vindicta_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo03_01",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo03_01.mp3",
          "text": "I'd quit while I was ahead.",
          "duration": 2.413
        },
        {
          "order": 2,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo03_02",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo03_02.mp3",
          "text": "What?",
          "duration": 0.631
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo03_03",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo03_03.mp3",
          "text": "I'd quit while I was ahead.",
          "duration": 3.022
        },
        {
          "order": 4,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo03_04",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo03_04.mp3",
          "text": "What are you going on about?",
          "duration": 1.563
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo03_05",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo03_05.mp3",
          "text": "Your war with the Friends of Humanity.  Martyring John Hathorne will galvanize them.",
          "duration": 6.146
        },
        {
          "order": 6,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo03_06",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo03_06.mp3",
          "text": "And when the next snake appears, I'll chop off its head too",
          "duration": 3.347
        },
        {
          "order": 7,
          "character": "Haze",
          "audioFile": "haze_match_start_haze_hornet_convo03_07",
          "audioUrl": "audio/haze_match_start_haze_hornet_convo03_07.mp3",
          "text": "And the one after that? And the one after that?",
          "duration": 3.739
        },
        {
          "order": 8,
          "character": "Vindicta",
          "audioFile": "hornet_match_start_haze_hornet_convo03_08",
          "audioUrl": "audio/hornet_match_start_haze_hornet_convo03_08.mp3",
          "text": "I'm dead Haze.  I have all the time in the world.",
          "duration": 2.985
        }
      ]
    }
  ]
}