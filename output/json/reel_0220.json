          "order": 6,
          "character": "Kelvin",
          "audioFile": "kelvin_match_start_kelvin_krill_convo01_06",
          "audioUrl": "audio/kelvin_match_start_kelvin_krill_convo01_06.mp3",
          "text": "I believe the ritual is about to start, but we'll catch up afterwards",
          "duration": 4.621
