{
  "conversations": [
    {
      "conversationId": "dynamo_seven_convo02",
      "lines": [
        {
          "order": 1,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo02_01",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo02_01.mp3",
          "text": "I'm a fan of your work Professor.",
          "duration": 2.537
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo02_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo02_02.mp3",
          "text": "I am flattered and horrified in equal measure",
          "duration": 3.454
        },
        {
          "order": 3,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo02_03",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo02_03.mp3",
          "text": "Your research into the Astral Gates paved the way for my own.  In my rare moments of doubt, sometimes I even wonder if I would have became the man I am were it not for you.",
          "duration": 11.73
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo02_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo02_04.mp3",
          "text": "and now I'm just horrifeid.",
          "duration": 1.623
        }
      ]
    },
    {
      "conversationId": "dynamo_seven_convo03",
      "lines": [
        {
          "order": 1,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo03_01",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo03_01.mp3",
          "text": "I'm sure it's a touchy subject, but I simply must know how you stopped your soul from being obliterated",
          "duration": 5.366
        },
        {
          "order": 2,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo03_02",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo03_02.mp3",
          "text": "I mean no disrespect Professor, but some things may be beyond you.",
          "duration": 5.845
        },
        {
          "order": 3,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo03_03",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo03_03.mp3",
          "text": "Many things are, but if I let that stop me from trying to learn I wouldn't be.. Well I probably would still have my body.",
          "duration": 8.141
        },
        {
          "order": 4,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo03_04",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo03_04.mp3",
          "text": "Hm.  Perhaps we're cut from the same cloth.",
          "duration": 3.998
        },
        {
          "order": 5,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_gigawatt_convo03_05",
          "audioUrl": "audio/dynamo_match_start_dynamo_gigawatt_convo03_05.mp3",
          "text": "Let's not go that far.",
          "duration": 1.332
        },
        {
          "order": 6,
          "character": "Seven",
          "audioFile": "gigawatt_match_start_dynamo_gigawatt_convo03_06",
          "audioUrl": "audio/gigawatt_match_start_dynamo_gigawatt_convo03_06.mp3",
          "text": "I'll consider your request, Professor.",
          "duration": 2.096
        }
      ]
    },
    {
      "conversationId": "dynamo_haze_convo01",
      "lines": [
        {
          "order": 1,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo01_01",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_01.mp3",
          "text": "Marlowe wanted me to tell you that the offer still stands.",
          "duration": 4.524
        },
        {
          "order": 2,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo01_02",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo01_02.mp3",
          "text": "For a moment I thought you said Marla and I got terribly confused.",
          "duration": 3.78
        },
        {
          "order": 3,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo01_03",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_03.mp3",
          "text": "It's a good offer.",
          "duration": 2.103
        },
        {
          "order": 4,
          "character": "Dynamo",
          "audioFile": "dynamo_match_start_dynamo_haze_convo01_04",
          "audioUrl": "audio/dynamo_match_start_dynamo_haze_convo01_04.mp3",
          "text": "I'm quite happy in the private sector.",
          "duration": 2.073
        },
        {
          "order": 5,
          "character": "Haze",
          "audioFile": "haze_match_start_dynamo_haze_convo01_05",
          "audioUrl": "audio/haze_match_start_dynamo_haze_convo01_05.mp3",
          "text": "You change your mind let me know.",
          "duration": 3.141
        }
      ]
    }
  ]
}